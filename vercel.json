{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm run install:all --prefix system",
  "buildCommand": "npm run build:vercel --prefix system",
  "outputDirectory": "system/client/dist",
  "functions": {
    "api/[...slug].js": {
      "maxDuration": 60,
      "memory": 1024,
      "includeFiles": "system/server/node_modules/.prisma/**"
    }
  },
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api/[...slug]" },
    {
      "source": "/((?!api/)(?!.*\\.).*)",
      "destination": "/index.html"
    }
  ]
}
