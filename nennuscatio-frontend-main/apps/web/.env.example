# Local web settings. To change one, copy this file to apps/web/.env.local (never committed).

# Data source: "mock" is demo mode with sample data, which `pnpm dev` uses (apps/web/.env.development).
# "api", the default, needs the API, which is not part of this repository. A production build refuses "mock".
# NEXT_PUBLIC_DATA_SOURCE=api

# Where the Next.js server forwards /api/* in "api" mode (server-only; set it at build time too).
# API_PROXY_ORIGIN=http://127.0.0.1:3002
