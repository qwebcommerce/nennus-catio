{
  "name": "@nennus-catio/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm -w contracts:build && next dev --hostname 127.0.0.1 --port 3000",
    "build": "pnpm -w contracts:build && next build",
    "start": "next start --hostname 127.0.0.1 --port 3000",
    "lint": "biome lint . --error-on-warnings",
    "typecheck": "pnpm -w contracts:build && next typegen && tsc --noEmit",
    "test": "pnpm -w contracts:build && vitest run"
  },
  "dependencies": {
    "@nennus-catio/contracts": "workspace:*",
    "@fontsource/inter": "5.3.0",
    "@fontsource/noto-sans-arabic": "5.3.0",
    "@fontsource/playfair-display": "5.3.0",
    "@radix-ui/react-dialog": "1.1.23",
    "@tanstack/react-query": "5.104.0",
    "lucide-react": "1.48.0",
    "next": "16.3.6",
    "next-intl": "4.14.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@nennus-catio/config": "workspace:*",
    "@biomejs/biome": "2.5.14",
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "24.19.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "jsdom": "27.4.0",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vite": "8.3.1",
    "vitest": "5.0.2"
  }
}
