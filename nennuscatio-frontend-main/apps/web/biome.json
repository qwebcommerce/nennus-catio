{
  "$schema": "https://biomejs.dev/schemas/2.5.14/schema.json",
  "files": {
    "includes": [
      "**",
      "!!.next",
      "!!node_modules",
      "!!coverage",
      "!!next-env.d.ts"
    ]
  },
  "formatter": { "indentStyle": "space", "indentWidth": 2 },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "a11y": { "noLabelWithoutControl": { "level": "error", "options": { "inputComponents": ["NumberInput"] } } },
      "style": { "noDescendingSpecificity": "off", "noNonNullAssertion": "off" }
    }
  },
  "css": { "parser": { "tailwindDirectives": true } }
}
