{
  "name": "@nennus-catio/contracts",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc --project tsconfig.build.json",
    "lint": "biome lint src tests --error-on-warnings",
    "typecheck": "tsc --project tsconfig.json --noEmit",
    "test": "node -e \"require('node:fs').rmSync('.test-dist',{recursive:true,force:true})\" && tsc --project tsconfig.test.json && node --test \".test-dist/tests/*.test.js\"",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm build"
  },
  "dependencies": {
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@nennus-catio/config": "workspace:*",
    "@types/node": "24.19.0",
    "typescript": "5.9.3"
  }
}
