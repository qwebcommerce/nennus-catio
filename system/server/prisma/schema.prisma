  @@index([organizationId, accountId])
  @@index([journalEntryId])
}

model AutomationRule {
  id             String            @id @default(cuid())
  organizationId String
  organization   Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  trigger        AutomationTrigger
  channel        AutomationChannel
  active         Boolean           @default(true)
  delayHours     Int               @default(0)
  cooldownDays   Int               @default(14)
  criteriaJson   Json?
  messageTemplate String
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  runs           AutomationRun[]
  logs           AutomationLog[]

  @@index([organizationId, active, trigger])
}

model AutomationRun {
  id             String          @id @default(cuid())
  organizationId String
  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  ruleId         String
  rule           AutomationRule  @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  startedAt      DateTime        @default(now())
  finishedAt     DateTime?
  processed      Int             @default(0)
  sent           Int             @default(0)
  failed         Int             @default(0)
  logs           AutomationLog[]

  @@index([organizationId, startedAt])
  @@index([ruleId, startedAt])
}

model AutomationLog {
  id             String            @id @default(cuid())
  organizationId String
  organization   Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  ruleId         String
  rule           AutomationRule    @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  runId          String?
  run            AutomationRun?    @relation(fields: [runId], references: [id], onDelete: SetNull)
  customerId     String?
  customer       Customer?         @relation(fields: [customerId], references: [id], onDelete: SetNull)
  trigger        AutomationTrigger
  channel        AutomationChannel
  status         ReminderStatus    @default(SENT)
  message        String
  error          String?
  createdAt      DateTime          @default(now())

  @@index([organizationId, createdAt])
  @@index([ruleId, customerId, createdAt])
}

model CommissionRule {
  id             String         @id @default(cuid())
  organizationId String
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  employeeId     String
  employee       Employee       @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  base           CommissionBase @default(APPOINTMENT_SERVICE_AMOUNT)
  percent        Decimal
  active         Boolean        @default(true)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  entries        CommissionEntry[]

  @@index([organizationId, employeeId, active])
}

model CommissionEntry {
  id               String         @id @default(cuid())
  organizationId   String
  organization     Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  employeeId       String
  employee         Employee       @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  ruleId           String?
  rule             CommissionRule? @relation(fields: [ruleId], references: [id], onDelete: SetNull)
  appointmentId    String?
  appointment      Appointment?   @relation(fields: [appointmentId], references: [id], onDelete: SetNull)
  baseAmount       Decimal
  percent          Decimal
  commissionAmount Decimal
  note             String?
  createdAt        DateTime       @default(now())

  @@index([organizationId, employeeId, createdAt])
  @@index([appointmentId])
}

model DeliveryOrder {
  id               String         @id @default(cuid())
  organizationId   String
  organization     Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branchId         String
  branch           Branch         @relation(fields: [branchId], references: [id], onDelete: Cascade)
  customerId       String?
  customer         Customer?      @relation(fields: [customerId], references: [id], onDelete: SetNull)
  sourceSaleId     String?
  addressText      String
  lat              Float?
  lng              Float?
  priority         Int            @default(0)
  /// Minutes from day start (0..1439) - optional delivery window start
  windowStartMin   Int?
  /// Minutes from day start (0..1439) - optional delivery window end
  windowEndMin     Int?
  status           DeliveryStatus @default(PENDING)
  scheduledDate    DateTime
  note             String?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  stop             DeliveryStop?

  @@index([organizationId, branchId, scheduledDate, status])
}

model DeliveryRoute {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branchId       String
  branch         Branch       @relation(fields: [branchId], references: [id], onDelete: Cascade)
  routeDate      DateTime
  driverName     String?
  vehicleName    String?
  lastDriverLat  Float?
  lastDriverLng  Float?
  lastDriverAt   DateTime?
  status         DeliveryStatus @default(ROUTED)
  totalStops     Int          @default(0)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  stops          DeliveryStop[]

  @@index([organizationId, branchId, routeDate, status])
}

model DeliveryStop {
  id              String       @id @default(cuid())
  organizationId  String
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  routeId         String
  route           DeliveryRoute @relation(fields: [routeId], references: [id], onDelete: Cascade)
  deliveryOrderId String       @unique
  deliveryOrder   DeliveryOrder @relation(fields: [deliveryOrderId], references: [id], onDelete: Cascade)
  branchId        String
  branch          Branch       @relation(fields: [branchId], references: [id], onDelete: Cascade)
  customerId      String?
  customer        Customer?    @relation(fields: [customerId], references: [id], onDelete: SetNull)
  sequence        Int
  etaAt           DateTime?
  deliveredAt     DateTime?
  status          DeliveryStatus @default(ROUTED)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@index([routeId, sequence])
  @@index([organizationId, status, createdAt])
}

model GroomingService {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branchId       String?
  branch         Branch?      @relation(fields: [branchId], references: [id], onDelete: SetNull)
  name           String
  durationMin    Int          @default(60)
  price          Decimal
  nameEn         String?
  included       String?
  includedEn     String?
  active         Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  appointments   Appointment[]
  petLinks       GroomingPackagePet[]

  @@index([organizationId, active])
}

model User {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  email          String
  passwordHash   String
  name           String
  nameEn         String?
  role           Role
  branchId       String?
  branch         Branch?      @relation(fields: [branchId], references: [id])
  sales          Sale[]
  refunds        Refund[]
  purchases      Purchase[]
  purchaseDrafts PurchaseDraft[]
  promoDrafts    PromoDraft[]
  cashSessionsOpened CashSession[] @relation("CashSessionOpenedBy")
  cashSessionsClosed CashSession[] @relation("CashSessionClosedBy")
  auditLogs          AuditLog[]
  heldCarts      HeldCart[]
  notificationReads NotificationRead[]
  employee          Employee?
  payrollPeriodsApproved PayrollPeriod[] @relation("PayrollApprovedBy")
  customerLedgerEntriesCreated CustomerAccountLedger[] @relation("CustomerLedgerCreatedBy")
  expensesCreated Expense[] @relation("ExpenseCreatedBy")
  appointmentsCreated Appointment[] @relation("AppointmentCreatedBy")
  purchaseOrdersCreated PurchaseOrder[]
  stockMovements StockMovement[]
  supplierPayments SupplierPayment[]
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([organizationId, email])
}

model Product {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  nameEn         String?
  shortTitle     String?
  shortTitleEn   String?
  description    String?
  descriptionEn  String?
  /// Centimetres. Optional.
  heightCm       Decimal?
  widthCm        Decimal?
  depthCm        Decimal?
  /// One feature per line.
  features       String?
  featuresEn     String?
  sku            String?
  barcode        String?
  price            Decimal
  /// سعر الجملة (اختياري) — يُستخدم في POS عند تفعيل وضع الجملة
  wholesalePrice   Decimal?
  cost             Decimal?
  petType        PetType      @default(OTHER)
  category       String?
  brandId        String?
  brand          Brand?       @relation(fields: [brandId], references: [id], onDelete: SetNull)
  categoryId     String?
  productCategory Category?   @relation("ProductCategory", fields: [categoryId], references: [id], onDelete: SetNull)
  subcategoryId  String?
  productSubcategory Subcategory? @relation("ProductSubcategory", fields: [subcategoryId], references: [id], onDelete: SetNull)
  imageUrl       String?
  /// Extra image URLs, after the main image.
  gallery        Json?
  sellBy         SellBy       @default(PIECE)
  preferredSupplierId String?
  preferredSupplier   Supplier? @relation("ProductPreferredSupplier", fields: [preferredSupplierId], references: [id], onDelete: SetNull)
  /// Ready-made pet house sold through the same checkout.
  isPetHouse       Boolean  @default(false)
  leadTimeDays     Int?
  houseDeliveryFee Decimal  @default(0)
  /// Made-to-order houses do not reduce on-hand quantity.
  takesStock       Boolean  @default(true)
  productImages  ProductImage[]
  isActive       Boolean      @default(true)
  petLinks       ProductPetType[]
  variants       ProductVariant[]
  externalId     String?
  /// اختياري: إضافات/خيارات للكافيه والمطاعم [{key,label,labelAr?,priceDelta}]
  modifiers      Json?
  /// تاريخ انتهاء الصلاحية (اختياري)
  expiryDate            DateTime?
  /// عدد الأيام قبل التاريخ لبدء التنبيه (إن وُجد تاريخ؛ الافتراضي في المنطق 14)
  expiryAlertDaysBefore Int?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  inventories    Inventory[]
  saleItems      SaleItem[]
  refundItems    RefundItem[]
  purchaseItems  PurchaseItem[]
  purchaseDraftItems PurchaseDraftItem[]
  promoDraftItems PromoDraftItem[]
  inventoryLots  InventoryLot[]
  stockMovements StockMovement[]
  stockHolds     StockHold[]
  promotions     Promotion[]

  @@unique([organizationId, sku])
  @@unique([organizationId, externalId])
  @@unique([organizationId, barcode])
}

model Inventory {
  id            String   @id @default(cuid())
  productId     String
  product       Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  branchId      String
  branch        Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)
  quantity      Int      @default(0)
  /// Last weighted unit cost at this location. Does not change the selling price.
  unitCost      Decimal?
  minStockLevel Int      @default(5)
  lots          InventoryLot[]

  @@unique([productId, branchId])
}

model Appointment {
  id              String            @id @default(cuid())
  organizationId  String
  organization    Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branchId        String?
  branch          Branch?           @relation(fields: [branchId], references: [id], onDelete: SetNull)
  customerId      String?
  customer        Customer?         @relation(fields: [customerId], references: [id], onDelete: SetNull)
  serviceId       String?
  service         GroomingService?  @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  groomerId       String?
  groomer         Employee?         @relation("AppointmentGroomer", fields: [groomerId], references: [id], onDelete: SetNull)
  petName         String?
  petType         PetType           @default(OTHER)
  breed           String?
  ageText         String?
  visitKind       VisitKind         @default(SHOP)
  address         String?
  areaId          String?
  area            DeliveryArea?     @relation(fields: [areaId], references: [id], onDelete: SetNull)
  homeFee         Decimal           @default(0)
  amount          Decimal           @default(0)
  holdExpiresAt   DateTime?
  gatewayPaymentId String?
  paymentReference String?
  /// Captured online payment (refunds are Payment rows of kind REFUND).
  amountPaid      Decimal           @default(0)
  paidAt          DateTime?
  /// A payment that staff must resolve (late, wrong amount, refund due).
  paymentReview   Boolean           @default(false)
  paymentReviewReason String?
  /// Short human reference customers and staff quote (NFR-22).
  reference       String?  @unique @default(dbgenerated("nc_ref('NC-GRM-'::text, 'nc_booking_ref_seq'::regclass)"))
  notes           String?
  status          AppointmentStatus @default(BOOKED)
  startAt         DateTime
  endAt           DateTime
  reminder24hAt   DateTime?
  reminder2hAt    DateTime?
  createdByUserId String
  createdBy       User              @relation("AppointmentCreatedBy", fields: [createdByUserId], references: [id])
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  reminders       AppointmentReminder[]
  commissionEntries CommissionEntry[]
  payments        Payment[]

  @@index([organizationId, branchId, startAt])
  @@index([organizationId, groomerId, startAt])
  @@index([organizationId, status])
}

model AppointmentReminder {
  id            String         @id @default(cuid())
  appointmentId String
  appointment   Appointment    @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  channel       ReminderChannel
  status        ReminderStatus @default(PENDING)
  scheduledAt   DateTime
  sentAt        DateTime?
  error         String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@index([status, scheduledAt])
}

model Sale {
  id               String          @id @default(cuid())
  branchId         String
  branch           Branch          @relation(fields: [branchId], references: [id])
  userId           String
  user             User            @relation(fields: [userId], references: [id])
  customerId       String?
  customer         Customer?       @relation(fields: [customerId], references: [id], onDelete: SetNull)
  /// تجزئة (POS) أو جملة (قسم الجملة)
  channel          SaleChannel     @default(RETAIL)
  /// Shop, van, or website. Separate from wholesale vs retail pricing.
  orderChannel     OrderChannel    @default(IN_STORE)
  /// Fawran or payment-link reference confirmed by staff.
  paymentReference String?
  webStatus        WebOrderStatus?
  fulfillment      FulfillmentKind?
  deliveryFee      Decimal         @default(0)
  deliveryAreaId   String?
  deliveryArea     DeliveryArea?   @relation(fields: [deliveryAreaId], references: [id], onDelete: SetNull)
  deliveryWindowId String?
  deliveryWindow   DeliveryWindow? @relation(fields: [deliveryWindowId], references: [id], onDelete: SetNull)
  gatewayPaymentId String?
  holdExpiresAt    DateTime?
  /// Calendar day of the delivery window, in Qatar.
  deliveryDate     DateTime?       @db.Date
  deliveryLat      Decimal?
  deliveryLng      Decimal?
  fleetwizReference String?
  fleetwizStatus   String?
  /// Gateway amount did not match the order. Staff decide.
  paymentReview    Boolean         @default(false)
  /// Why the payment needs staff: AMOUNT_MISMATCH, LATE_PAYMENT, STOCK_CHANGED, DUPLICATE_PAYMENT.
  paymentReviewReason String?
  /// Short human reference customers and staff quote (NFR-22).
  reference        String?  @unique @default(dbgenerated("nc_ref('NC-ORD-'::text, 'nc_order_ref_seq'::regclass)"))
  promotionDiscount Decimal        @default(0)
  clientMutationId String?         @unique
  total            Decimal
  discountAmount   Decimal         @default(0)
  taxAmount        Decimal         @default(0)
  /// VAT percent applied on this sale (snapshot)
  taxPercent       Decimal?
  paymentMethod    PaymentMethod
  paymentSplits    Json?
  cashSessionId    String?
  cashSession      CashSession?    @relation(fields: [cashSessionId], references: [id], onDelete: SetNull)
  couponId         String?
  coupon           Coupon?         @relation(fields: [couponId], references: [id], onDelete: SetNull)
  couponDiscountAmount Decimal     @default(0)
  loyaltyPointsRedeemed Int        @default(0)
  loyaltyDiscountAmount Decimal    @default(0)
  loyaltyPointsEarned   Int?
  loyaltyAwardStatus    LoyaltyAwardStatus @default(NONE)
  /// صافي المبلغ المؤهل لاحتساب النقاط (بعد خصم الفاتورة والكوبون، قبل استبدال النقاط)
  loyaltyEligibleBase   Decimal?
  /// ما دُفع فعلياً في هذه العملية (نقد/بطاقة/…)
  amountPaid       Decimal         @default(0)
  /// المتبقي على ذمّة الزبون لهذه الفاتورة
  amountDue        Decimal         @default(0)
  invoiceNumber    String?
  invoiceStatus    InvoiceStatus   @default(ISSUED)
  dueDate          DateTime?
  paidAt           DateTime?
  /// رقم الطاولة (كافيه / مطعم)
  tableNumber      String?
  /// ملاحظات الطلب
  orderNote        String?
  /// عنوان التوصيل (للبيع عند الاستلام)
  deliveryAddress  String?
  createdAt        DateTime        @default(now())
  items            SaleItem[]
  refunds          Refund[]
  loyaltyLedgers   LoyaltyLedger[]
  customerAccountLedgers CustomerAccountLedger[]
  stockHolds       StockHold[]
  payments         Payment[]

  @@unique([invoiceNumber])
}

model HeldCart {
