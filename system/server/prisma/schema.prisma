  createdAt        DateTime     @default(now())
}

model RefundItem {
  id        String  @id @default(cuid())
  refundId  String
  refund    Refund  @relation(fields: [refundId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id])
  quantity  Int
  unitPrice Decimal
  subtotal  Decimal
  /// Cost reversed when the goods are returned. Empty when the refund is money only.
  costAmount Decimal?
}

model Purchase {
  id         String         @id @default(cuid())
  supplierId String?
  supplier   Supplier?      @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  branchId   String
  branch     Branch         @relation(fields: [branchId], references: [id])
  userId     String
  user       User           @relation(fields: [userId], references: [id])
  note       String?
  createdAt  DateTime       @default(now())
  items      PurchaseItem[]
  fromDraft  PurchaseDraft?
}

model PurchaseItem {
  id         String   @id @default(cuid())
  purchaseId String
  purchase   Purchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  productId  String
  product    Product  @relation(fields: [productId], references: [id])
  quantity   Int
  unitCost   Decimal
  subtotal   Decimal
  expiryDate DateTime?
}

/// Smart Reorder draft PO — review before converting to a real Purchase receipt
model PurchaseDraft {
  id             String              @id @default(cuid())
  organizationId String
  organization   Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branchId       String
  branch         Branch              @relation(fields: [branchId], references: [id], onDelete: Cascade)
  supplierId     String?
  supplier       Supplier?           @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  userId         String
  user           User                @relation(fields: [userId], references: [id])
  /// OPEN | CONVERTED | CANCELLED
  status         String              @default("OPEN")
  note           String?
  /// REORDER | MANUAL | MIXED
  source         String              @default("REORDER")
  purchaseId     String?             @unique
  purchase       Purchase?           @relation(fields: [purchaseId], references: [id], onDelete: SetNull)
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  items          PurchaseDraftItem[]

  @@index([organizationId, branchId, status])
}

model PurchaseDraftItem {
  id        String        @id @default(cuid())
  draftId   String
  draft     PurchaseDraft @relation(fields: [draftId], references: [id], onDelete: Cascade)
  productId String
  product   Product       @relation(fields: [productId], references: [id])
  quantity  Int
  unitCost  Decimal?
  /// Why this line was suggested (severity / dailySales snapshot)
  reason    String?
  createdAt DateTime      @default(now())

  @@index([draftId])
}

/// Module 2: Intelligent Pricing & Promo Engine — review before applying price/coupon changes
model PromoDraft {
  id             String           @id @default(cuid())
  organizationId String
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branchId       String?
  branch         Branch?          @relation(fields: [branchId], references: [id], onDelete: SetNull)
  userId         String
  user           User             @relation(fields: [userId], references: [id])
  /// OPEN | APPLIED | CANCELLED
  status         String           @default("OPEN")
  /// MARKDOWN | PRICE_CHANGE | COUPON | BUNDLE
  kind           String           @default("MARKDOWN")
  /// PRICE | COUPON — how convert applies
  applyMode      String           @default("PRICE")
  /// WASTE | VELOCITY | MARGIN | BUNDLE | MANUAL | SIMULATOR
  source         String           @default("MANUAL")
  title          String?
  note           String?
  couponId       String?
  coupon         Coupon?          @relation(fields: [couponId], references: [id], onDelete: SetNull)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  items          PromoDraftItem[]

  @@index([organizationId, status])
  @@index([organizationId, branchId, status])
}

model PromoDraftItem {
  id              String     @id @default(cuid())
  draftId         String
  draft           PromoDraft @relation(fields: [draftId], references: [id], onDelete: Cascade)
  productId       String
  product         Product    @relation(fields: [productId], references: [id])
  /// PERCENT_OFF | SET_PRICE | BUNDLE
  action          String     @default("PERCENT_OFF")
  currentPrice    Decimal?
  cost            Decimal?
  suggestedPrice  Decimal?
  discountPercent Decimal?
  /// Snapshot of price before apply (for audit / future revert)
  previousPrice   Decimal?
  buyQty          Int?
  freeQty         Int?
  pairedProductId String?
  reason          String?
  createdAt       DateTime   @default(now())

  @@index([draftId])
}

model SaleItem {
  id        String   @id @default(cuid())
  saleId    String
  sale      Sale     @relation(fields: [saleId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id])
  variantId String?
  variant   ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  /// Pieces, or grams when the product is sold by weight.
  quantity  Int
  unitPrice Decimal
  subtotal  Decimal
  discountAmount Decimal @default(0)
  /// Location unit cost at the time of the sale. Does not change the selling price.
  unitCost  Decimal?
  costAmount Decimal?
  /// الإضافات المختارة للسطر [{key,label,priceDelta}]
  modifiers Json?
  lotUsages SaleItemLot[]
}

/// لوتات المخزون (دفعات استلام منفصلة) لتتبع الصلاحية واستهلاك FEFO
model InventoryLot {
  id               String        @id @default(cuid())
  organizationId   String
  organization     Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  productId        String
  product          Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  branchId         String
  branch           Branch        @relation(fields: [branchId], references: [id], onDelete: Cascade)
  inventoryId      String?
  inventory        Inventory?    @relation(fields: [inventoryId], references: [id], onDelete: SetNull)
  receivedAt       DateTime      @default(now())
  expiryDate       DateTime?
  quantityReceived Int
  quantityOnHand   Int
  unitCost         Decimal?
  note             String?
  saleItemLots     SaleItemLot[]
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  @@index([organizationId, branchId, productId, expiryDate])
  @@index([organizationId, branchId, productId, quantityOnHand])
}

/// تتبع أي SaleItem سحب كم كمية من أي Lot
model SaleItemLot {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  saleItemId     String
  saleItem       SaleItem     @relation(fields: [saleItemId], references: [id], onDelete: Cascade)
  inventoryLotId String
  inventoryLot   InventoryLot @relation(fields: [inventoryLotId], references: [id], onDelete: Cascade)
  quantity       Int
  createdAt      DateTime     @default(now())

  @@index([organizationId, saleItemId])
  @@index([inventoryLotId])
}

/// تتبع قراءة عناصر تغذية التنبيهات (مفتاح مستقر لكل عنصر)
model NotificationRead {
  id               String       @id @default(cuid())
  userId           String
  user             User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organizationId   String
  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  notificationKey  String
  readAt           DateTime     @default(now())

  @@unique([userId, notificationKey])
  @@index([organizationId])
}

model SyncSettings {
  id                     String       @id @default(cuid())
  organizationId       String       @unique
  organization         Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  websiteBaseUrl       String?
  apiKey               String?
  /// POST JSON عند تغيّر المخزون (Next.js أو أي API) — يُرسل Authorization: Bearer من apiKey إن وُجد
  inventoryWebhookUrl  String?
  lastProductSyncAt    DateTime?
  lastOrderSyncAt      DateTime?
  lastSupabaseSyncAt   DateTime?
  updatedAt            DateTime     @updatedAt
}

model CatalogPetType {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  nameEn         String?
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  products       ProductPetType[]
  pets           CustomerPet[]
  groomingPackages GroomingPackagePet[]

  @@index([organizationId, isActive])
}

model ProductPetType {
  productId String
  petTypeId String
  product   Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  petType   CatalogPetType @relation(fields: [petTypeId], references: [id], onDelete: Cascade)

  @@id([productId, petTypeId])
}

model ProductVariant {
  id                  String    @id @default(cuid())
  organizationId      String
  organization        Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  productId           String
  product             Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  sku                 String?
  barcode             String?
  label               String
  labelEn             String?
  price               Decimal
  isActive            Boolean   @default(true)
  packWeight          Decimal?
  preferredSupplierId String?
  preferredSupplier   Supplier? @relation("VariantPreferredSupplier", fields: [preferredSupplierId], references: [id], onDelete: SetNull)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  stocks              VariantStock[]
  saleItems           SaleItem[]
  orderLines          PurchaseOrderLine[]
  stockMovements      StockMovement[]
  stockHolds          StockHold[]

  @@unique([organizationId, sku])
  @@unique([organizationId, barcode])
  @@index([productId])
}

model VariantStock {
  id            String         @id @default(cuid())
  variantId     String
  variant       ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  branchId      String
  branch        Branch         @relation(fields: [branchId], references: [id], onDelete: Cascade)
  quantity      Int            @default(0)
  unitCost      Decimal?
  minStockLevel Int            @default(5)

  @@unique([variantId, branchId])
  @@index([branchId])
}

model PurchaseOrder {
  id             String              @id @default(cuid())
  organizationId String
  organization   Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  supplierId     String
  supplier       Supplier            @relation(fields: [supplierId], references: [id])
  branchId       String
  branch         Branch              @relation(fields: [branchId], references: [id])
  userId         String
  user           User                @relation(fields: [userId], references: [id])
  status         PurchaseOrderStatus @default(DRAFT)
  note           String?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  lines          PurchaseOrderLine[]
  bills          SupplierBill[]

  @@index([organizationId, status])
}

model PurchaseOrderLine {
  id               String         @id @default(cuid())
  orderId          String
  order            PurchaseOrder  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId        String
  variantId        String?
  variant          ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  quantity         Int
  quantityReceived Int            @default(0)
  unitCost         Decimal

  @@index([orderId])
}

model SupplierBill {
  id             String             @id @default(cuid())
  organizationId String
  organization   Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  supplierId     String
  supplier       Supplier           @relation(fields: [supplierId], references: [id])
  purchaseOrderId String?
  purchaseOrder  PurchaseOrder?     @relation(fields: [purchaseOrderId], references: [id], onDelete: SetNull)
  amount         Decimal
  amountPaid     Decimal            @default(0)
  status         SupplierBillStatus @default(OPEN)
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  payments       SupplierPayment[]

  @@index([organizationId, supplierId, status])
}

model SupplierPayment {
  id        String            @id @default(cuid())
  billId    String
  bill      SupplierBill      @relation(fields: [billId], references: [id], onDelete: Cascade)
  amount    Decimal
  method    SupplierPayMethod
  paidAt    DateTime          @default(now())
  userId    String
  user      User              @relation(fields: [userId], references: [id])
  note      String?
}

model StockMovement {
  id             String          @id @default(cuid())
  organizationId String
  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  productId      String
  product        Product         @relation(fields: [productId], references: [id])
  variantId      String?
  variant        ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  branchId       String
  branch         Branch          @relation(fields: [branchId], references: [id])
  quantityDelta  Int
  reason         StockMoveReason
  note           String?
  userId         String?
  user           User?           @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt      DateTime        @default(now())

  @@index([organizationId, branchId, createdAt])
  @@index([productId])
}

model StockHold {
  id             String         @id @default(cuid())
  organizationId String
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  saleId         String
  sale           Sale           @relation(fields: [saleId], references: [id], onDelete: Cascade)
  productId      String
  product        Product        @relation(fields: [productId], references: [id])
  variantId      String?
  variant        ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  branchId       String
  branch         Branch         @relation(fields: [branchId], references: [id])
  quantity       Int
  windowId       String?
  window         DeliveryWindow? @relation(fields: [windowId], references: [id], onDelete: SetNull)
  status         HoldStatus     @default(HELD)
  expiresAt      DateTime
  releasedAt     DateTime?
  createdAt      DateTime       @default(now())

  @@index([saleId, status])
  @@index([branchId, productId, status])
}

model DeliveryArea {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  nameEn         String?
  city           String?
  fee            Decimal      @default(0)
  isActive       Boolean      @default(true)
  sales          Sale[]
  appointments   Appointment[]
  createdAt      DateTime     @default(now())
}

model DeliveryWindow {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  label          String
  labelEn        String?
  /// 0 = Sunday … 6 = Saturday. Null means any day.
  weekday        Int?
  startTime      String
  endTime        String
  seats          Int          @default(4)
  isActive       Boolean      @default(true)
  sales          Sale[]
  holds          StockHold[]
  createdAt      DateTime     @default(now())
}

model CustomerPet {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customerId     String
  customer       Customer     @relation(fields: [customerId], references: [id], onDelete: Cascade)
  petTypeId      String?
  petType        CatalogPetType? @relation(fields: [petTypeId], references: [id], onDelete: SetNull)
  name           String
  breed          String?
  ageText        String?
  /// Staff only. Never returned to the customer account.
  notes          String?
  createdAt      DateTime     @default(now())
  relocationLinks RelocationPet[]

  @@index([customerId])
}

model CustomerAddress {
  id         String   @id @default(cuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  label      String?
  line1      String
  area       String?
  city       String?
  lat        Decimal?
  lng        Decimal?
  isDefault  Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@index([customerId])
}

model GroomingSchedule {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  /// 0 = Sunday … 6 = Saturday.
  weekday        Int
  startTime      String
  endTime        String
  capacity       Int          @default(1)
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now())

  @@index([organizationId, weekday])
}

model GroomingPackagePet {
  serviceId String
  petTypeId String
  service   GroomingService @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  petType   CatalogPetType  @relation(fields: [petTypeId], references: [id], onDelete: Cascade)

  @@id([serviceId, petTypeId])
}

model RelocationRequest {
  id             String           @id @default(cuid())
  organizationId String
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customerId     String
  customer       Customer         @relation(fields: [customerId], references: [id], onDelete: Cascade)
  destination    String
  petSummary     String?
  status         RelocationStatus @default(SUBMITTED)
  quoteAmount    Decimal?
  quoteNote      String?
  /// Hidden from the customer.
  staffNotes     String?
  history        Json?
  paymentMethod  String?
  gatewayPaymentId String?
  paidAt         DateTime?
  amountPaid     Decimal          @default(0)
  paymentReview  Boolean          @default(false)
  paymentReviewReason String?
  /// Short human reference customers and staff quote (NFR-22).
  reference      String?  @unique @default(dbgenerated("nc_ref('NC-REL-'::text, 'nc_relocation_ref_seq'::regclass)"))
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  pets           RelocationPet[]
  documents      RelocationDocument[]
  payments       Payment[]

  @@index([organizationId, status])
  @@index([customerId])
}

model RelocationPet {
  requestId String
  petId     String
  request   RelocationRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  pet       CustomerPet       @relation(fields: [petId], references: [id], onDelete: Cascade)

  @@id([requestId, petId])
}

model RelocationDocument {
  id         String            @id @default(cuid())
  requestId  String
  request    RelocationRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  fileName   String
  mime       String
  content    Bytes
  createdAt  DateTime          @default(now())

  @@index([requestId])
}

model Promotion {
  id             String        @id @default(cuid())
  organizationId String
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  nameEn         String?
  kind           PromotionKind
  code           String?
  percent        Decimal?
  amount         Decimal?
  productId      String?
  product        Product?      @relation(fields: [productId], references: [id], onDelete: SetNull)
  categoryId     String?
  category       Category?     @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  buyQty         Int?
  getQty         Int?
  bundleProductIds Json?
  bundlePrice    Decimal?
  minOrderAmount Decimal?
  startsAt       DateTime      @default(now())
  endsAt         DateTime?
  active         Boolean       @default(true)
  channel        PromoChannel  @default(ALL)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([organizationId, active])
}

model Vehicle {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  plate          String
  branchId       String?      @unique
  branch         Branch?      @relation(fields: [branchId], references: [id], onDelete: SetNull)
  isActive       Boolean      @default(true)
  notes          String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([organizationId, isActive])
}

/// Money received or returned for exactly one order, booking or relocation quote ("One payment parent").
model Payment {
  id                  String             @id @default(cuid())
  organizationId      String
  saleId              String?
  sale                Sale?              @relation(fields: [saleId], references: [id], onDelete: Restrict)
  appointmentId       String?
  appointment         Appointment?       @relation(fields: [appointmentId], references: [id], onDelete: Restrict)
  relocationRequestId String?
  relocationRequest   RelocationRequest? @relation(fields: [relocationRequestId], references: [id], onDelete: Restrict)
  /// PAYMENT or REFUND.
  kind                String             @default("PAYMENT")
  /// ONLINE, CASH or BANK.
  method              String
  /// CAPTURED, REVIEW (staff must resolve), REJECTED (refunded after review), PENDING (refund in flight).
  status              String             @default("CAPTURED")
  amount              Decimal
  currency            String             @default("QAR")
  reference           String?
  gatewayPaymentId    String?
  gatewayRefundId     String?
  reviewReason        String?
  /// Staff user who recorded it (null for gateway notifications).
  userId              String?
  note                String?
  createdAt           DateTime           @default(now())

  @@index([saleId])
  @@index([appointmentId])
  @@index([relocationRequestId])
  @@index([organizationId, status])
}
