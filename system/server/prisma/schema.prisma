model Sale {
  id               String          @id @default(cuid())
  branchId         String
  branch           Branch          @relation(fields: [branchId], references: [id])
  userId           String
  user             User            @relation(fields: [userId], references: [id])
  customerId       String?
  customer         Customer?       @relation(fields: [customerId], references: [id], onDelete: SetNull)
  /// تجزئة (POS) أو جملة (قسم الجملة)
  channel          SaleChannel     @default(RETAIL)
  /// Shop, van, or website. Separate from wholesale vs retail pricing.
  orderChannel     OrderChannel    @default(IN_STORE)
  /// Fawran or payment-link reference confirmed by staff.
  paymentReference String?
  webStatus        WebOrderStatus?
  fulfillment      FulfillmentKind?
  deliveryFee      Int             @default(0)
  deliveryAreaId   String?
  deliveryArea     DeliveryArea?   @relation(fields: [deliveryAreaId], references: [id], onDelete: SetNull)
  deliveryWindowId String?
  deliveryWindow   DeliveryWindow? @relation(fields: [deliveryWindowId], references: [id], onDelete: SetNull)
  gatewayPaymentId String?
  holdExpiresAt    DateTime?
  /// Calendar day of the delivery window, in Qatar.
  deliveryDate     DateTime?       @db.Date
  deliveryLat      Decimal?
  deliveryLng      Decimal?
  fleetwizReference String?
  fleetwizStatus   String?
  /// Gateway amount did not match the order. Staff decide.
  paymentReview    Boolean         @default(false)
  /// Why the payment needs staff: AMOUNT_MISMATCH, LATE_PAYMENT, STOCK_CHANGED, DUPLICATE_PAYMENT.
  paymentReviewReason String?
  /// Short human reference customers and staff quote (NFR-22).
  reference        String?  @unique @default(dbgenerated("nc_ref('NC-ORD-'::text, 'nc_order_ref_seq'::regclass)"))
  promotionDiscount Int            @default(0)
  clientMutationId String?         @unique
  total            Int
  discountAmount   Int             @default(0)
  taxAmount        Int             @default(0)
  /// VAT percent applied on this sale (snapshot)
  taxPercent       Decimal?
  paymentMethod    PaymentMethod
  paymentSplits    Json?
  cashSessionId    String?
  cashSession      CashSession?    @relation(fields: [cashSessionId], references: [id], onDelete: SetNull)
  couponId         String?
  coupon           Coupon?         @relation(fields: [couponId], references: [id], onDelete: SetNull)
  couponDiscountAmount Int         @default(0)
  loyaltyPointsRedeemed Int        @default(0)
  loyaltyDiscountAmount Int        @default(0)
  loyaltyPointsEarned   Int?
  loyaltyAwardStatus    LoyaltyAwardStatus @default(NONE)
  /// صافي المبلغ المؤهل لاحتساب النقاط (بعد خصم الفاتورة والكوبون، قبل استبدال النقاط)
  loyaltyEligibleBase   Int?
  /// ما دُفع فعلياً في هذه العملية (نقد/بطاقة/…)
  amountPaid       Int             @default(0)
  /// المتبقي على ذمّة الزبون لهذه الفاتورة
  amountDue        Int             @default(0)
  invoiceNumber    String?
  invoiceStatus    InvoiceStatus   @default(ISSUED)
  dueDate          DateTime?
  paidAt           DateTime?
  /// رقم الطاولة (كافيه / مطعم)
  tableNumber      String?
  /// ملاحظات الطلب
  orderNote        String?
  /// عنوان التوصيل (للبيع عند الاستلام)
  deliveryAddress  String?
  createdAt        DateTime        @default(now())
  items            SaleItem[]
  refunds          Refund[]
  loyaltyLedgers   LoyaltyLedger[]
  customerAccountLedgers CustomerAccountLedger[]
  stockHolds       StockHold[]
  payments         Payment[]

  @@unique([invoiceNumber])
  /// Why goods on this sale were given free (required when any line is free).
  freeReason       String?
}

model HeldCart {
  id        String   @id @default(cuid())
  branchId  String
  branch    Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  label     String?
  payload   Json
  lineCount Int      @default(0)
  subtotal  Int      @default(0)
  createdAt DateTime @default(now())

  @@index([branchId, userId])
}

model CashSession {
  id                 String    @id @default(cuid())
  branchId           String
  branch             Branch    @relation(fields: [branchId], references: [id])
  openedByUserId     String
  openedBy           User      @relation("CashSessionOpenedBy", fields: [openedByUserId], references: [id])
  closedByUserId     String?
  closedBy           User?     @relation("CashSessionClosedBy", fields: [closedByUserId], references: [id])
  openedAt           DateTime  @default(now())
  closedAt           DateTime?
  openingFloat       Int       @default(0)
  closingCountedCash Int?
  expectedCash       Int?
  cashVariance       Int?
  /// Card taken in the session, net of card refunds. Set at close.
  cardTotal          Int?
  note               String?
  sales              Sale[]
  refunds            Refund[]
  vanReturns         VanReturn[]
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action     String
  entityType String?
  entityId   String?
  branchId   String?
  branch     Branch?  @relation(fields: [branchId], references: [id], onDelete: SetNull)
  summary    String?
  meta       String?
  createdAt  DateTime @default(now())
}

model Refund {
  id               String       @id @default(cuid())
  branchId         String
  branch           Branch       @relation(fields: [branchId], references: [id])
  userId           String
  user             User         @relation(fields: [userId], references: [id])
  saleId           String?
  sale             Sale?        @relation(fields: [saleId], references: [id], onDelete: SetNull)
  clientMutationId String?      @unique
  total            Int
  note             String?
  gatewayRefundId  String?
  /// How the money went back (cash, card, Fawran, link). Empty on old rows.
  method           PaymentMethod?
  /// Till session the cash left from. Expected cash at close subtracts it.
  cashSessionId    String?
  cashSession      CashSession? @relation(fields: [cashSessionId], references: [id], onDelete: SetNull)
  createdAt        DateTime     @default(now())
  items            RefundItem[]

  @@index([cashSessionId])
}

model OfflineInventoryReceipt {
  clientMutationId String       @id
  organizationId   String
  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  payload          Json
  createdAt        DateTime     @default(now())
}

model RefundItem {
  id        String  @id @default(cuid())
  refundId  String
  refund    Refund  @relation(fields: [refundId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id])
  quantity  Int
  unitPrice Int
  subtotal  Int
  /// Cost reversed when the goods are returned. Empty when the refund is money only.
  costAmount Int?
  /// Sale line this refund line comes from. Empty on old rows.
  saleItemId String?
  variantId  String?

  @@index([saleItemId])
}

model Purchase {
  id         String         @id @default(cuid())
  supplierId String?
  supplier   Supplier?      @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  branchId   String
  branch     Branch         @relation(fields: [branchId], references: [id])
  userId     String
  user       User           @relation(fields: [userId], references: [id])
  note       String?
  createdAt  DateTime       @default(now())
  items      PurchaseItem[]
  fromDraft  PurchaseDraft?
}

model PurchaseItem {
  id         String   @id @default(cuid())
  purchaseId String
  purchase   Purchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  productId  String
  product    Product  @relation(fields: [productId], references: [id])
  quantity   Int
  unitCost   Int
  subtotal   Int
  expiryDate DateTime?
}

/// Smart Reorder draft PO — review before converting to a real Purchase receipt
model PurchaseDraft {
  id             String              @id @default(cuid())
  organizationId String
  organization   Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branchId       String
  branch         Branch              @relation(fields: [branchId], references: [id], onDelete: Cascade)
  supplierId     String?
  supplier       Supplier?           @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  userId         String
  user           User                @relation(fields: [userId], references: [id])
  /// OPEN | CONVERTED | CANCELLED
  status         String              @default("OPEN")
  note           String?
  /// REORDER | MANUAL | MIXED
  source         String              @default("REORDER")
  purchaseId     String?             @unique
  purchase       Purchase?           @relation(fields: [purchaseId], references: [id], onDelete: SetNull)
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  items          PurchaseDraftItem[]

  @@index([organizationId, branchId, status])
}

model PurchaseDraftItem {
  id        String        @id @default(cuid())
  draftId   String
  draft     PurchaseDraft @relation(fields: [draftId], references: [id], onDelete: Cascade)
  productId String
  product   Product       @relation(fields: [productId], references: [id])
  quantity  Int
  unitCost  Int?
  /// Why this line was suggested (severity / dailySales snapshot)
  reason    String?
  createdAt DateTime      @default(now())

  @@index([draftId])
}

/// Module 2: Intelligent Pricing & Promo Engine — review before applying price/coupon changes
model PromoDraft {
  id             String           @id @default(cuid())
  organizationId String
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branchId       String?
  branch         Branch?          @relation(fields: [branchId], references: [id], onDelete: SetNull)
  userId         String
  user           User             @relation(fields: [userId], references: [id])
  /// OPEN | APPLIED | CANCELLED
  status         String           @default("OPEN")
  /// MARKDOWN | PRICE_CHANGE | COUPON | BUNDLE
  kind           String           @default("MARKDOWN")
  /// PRICE | COUPON — how convert applies
  applyMode      String           @default("PRICE")
  /// WASTE | VELOCITY | MARGIN | BUNDLE | MANUAL | SIMULATOR
  source         String           @default("MANUAL")
  title          String?
  note           String?
  couponId       String?
  coupon         Coupon?          @relation(fields: [couponId], references: [id], onDelete: SetNull)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  items          PromoDraftItem[]

  @@index([organizationId, status])
  @@index([organizationId, branchId, status])
}

model PromoDraftItem {
  id              String     @id @default(cuid())
  draftId         String
  draft           PromoDraft @relation(fields: [draftId], references: [id], onDelete: Cascade)
  productId       String
  product         Product    @relation(fields: [productId], references: [id])
  /// PERCENT_OFF | SET_PRICE | BUNDLE
  action          String     @default("PERCENT_OFF")
  currentPrice    Int?
  cost            Int?
  suggestedPrice  Int?
  discountPercent Decimal?
  /// Snapshot of price before apply (for audit / future revert)
  previousPrice   Int?
  buyQty          Int?
  freeQty         Int?
  pairedProductId String?
  reason          String?
  createdAt       DateTime   @default(now())

  @@index([draftId])
}

model SaleItem {
  id        String   @id @default(cuid())
  saleId    String
  sale      Sale     @relation(fields: [saleId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id])
  variantId String?
  variant   ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  /// Pieces, or grams when the product is sold by weight.
  quantity  Int
  unitPrice Int
  subtotal  Int
  discountAmount Int     @default(0)
  /// Location unit cost at the time of the sale. Does not change the selling price.
  unitCost  Int?
  costAmount Int?
  /// الإضافات المختارة للسطر [{key,label,priceDelta}]
  modifiers Json?
  lotUsages SaleItemLot[]
  /// Complimentary (free) line: no revenue, cost reported as Complimentary.
  isFree    Boolean  @default(false)
}

/// لوتات المخزون (دفعات استلام منفصلة) لتتبع الصلاحية واستهلاك FEFO
model InventoryLot {
  id               String        @id @default(cuid())
  organizationId   String
  organization     Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  productId        String
  product          Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  branchId         String
  branch           Branch        @relation(fields: [branchId], references: [id], onDelete: Cascade)
  inventoryId      String?
  inventory        Inventory?    @relation(fields: [inventoryId], references: [id], onDelete: SetNull)
  receivedAt       DateTime      @default(now())
  expiryDate       DateTime?
  quantityReceived Int
  quantityOnHand   Int
  unitCost         Int?
  note             String?
  saleItemLots     SaleItemLot[]
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  @@index([organizationId, branchId, productId, expiryDate])
  @@index([organizationId, branchId, productId, quantityOnHand])
}

/// تتبع أي SaleItem سحب كم كمية من أي Lot
model SaleItemLot {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  saleItemId     String
  saleItem       SaleItem     @relation(fields: [saleItemId], references: [id], onDelete: Cascade)
  inventoryLotId String
  inventoryLot   InventoryLot @relation(fields: [inventoryLotId], references: [id], onDelete: Cascade)
  quantity       Int
  createdAt      DateTime     @default(now())

  @@index([organizationId, saleItemId])
  @@index([inventoryLotId])
}

/// تتبع قراءة عناصر تغذية التنبيهات (مفتاح مستقر لكل عنصر)
model NotificationRead {
  id               String       @id @default(cuid())
  userId           String
  user             User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organizationId   String
  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  notificationKey  String
  readAt           DateTime     @default(now())

  @@unique([userId, notificationKey])
  @@index([organizationId])
}

model SyncSettings {
  id                     String       @id @default(cuid())
  organizationId       String       @unique
  organization         Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  websiteBaseUrl       String?
  apiKey               String?
  /// POST JSON عند تغيّر المخزون (Next.js أو أي API) — يُرسل Authorization: Bearer من apiKey إن وُجد
  inventoryWebhookUrl  String?
  lastProductSyncAt    DateTime?
  lastOrderSyncAt      DateTime?
  lastSupabaseSyncAt   DateTime?
  updatedAt            DateTime     @updatedAt
}

model CatalogPetType {
  id             String       @id @default(cuid())
  /// NFR-13: optimistic-lock version, bumped on every write
  version Int @default(1)
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  nameEn         String?
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  products       ProductPetType[]
  pets           CustomerPet[]
  groomingPackages GroomingPackagePet[]

  @@index([organizationId, isActive])
}

model ProductPetType {
  productId String
  petTypeId String
  product   Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  petType   CatalogPetType @relation(fields: [petTypeId], references: [id], onDelete: Cascade)

  @@id([productId, petTypeId])
}

model ProductVariant {
  id                  String    @id @default(cuid())
  /// NFR-13: optimistic-lock version, bumped on every write
  version Int @default(1)
  organizationId      String
  organization        Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  productId           String
  product             Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  sku                 String?
  barcode             String?
  label               String
  labelEn             String?
  price               Int
  isActive            Boolean   @default(true)
  packWeight          Decimal?
  /// Optional: pieces (bags) in one carton, 2 or more. Falls back to the product's value.
  piecesPerCarton     Int?
  preferredSupplierId String?
  preferredSupplier   Supplier? @relation("VariantPreferredSupplier", fields: [preferredSupplierId], references: [id], onDelete: SetNull)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  stocks              VariantStock[]
  saleItems           SaleItem[]
  orderLines          PurchaseOrderLine[]
  stockMovements      StockMovement[]
  stockHolds          StockHold[]
  transferLines       StockTransferLine[]
  vanReturnLines      VanReturnLine[]
  damagedStocks       DamagedStock[]

  @@unique([organizationId, sku])
  @@unique([organizationId, barcode])
  @@index([productId])
  salesOrderLines     SalesOrderLine[]
}

model VariantStock {
  id            String         @id @default(cuid())
  variantId     String
  variant       ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  branchId      String
  branch        Branch         @relation(fields: [branchId], references: [id], onDelete: Cascade)
  quantity      Int            @default(0)
  unitCost      Int?
  minStockLevel Int            @default(5)

  @@unique([variantId, branchId])
  @@index([branchId])
}

model PurchaseOrder {
  id             String              @id @default(cuid())
  /// NFR-13: optimistic-lock version, bumped on every write
  version Int @default(1)
  organizationId String
  organization   Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  supplierId     String
  supplier       Supplier            @relation(fields: [supplierId], references: [id])
  branchId       String
  branch         Branch              @relation(fields: [branchId], references: [id])
  userId         String
  user           User                @relation(fields: [userId], references: [id])
  status         PurchaseOrderStatus @default(DRAFT)
  note           String?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  lines          PurchaseOrderLine[]
  bills          SupplierBill[]

  @@index([organizationId, status])
  /// Expected delivery date (pending stock).
  expectedDate   DateTime?           @db.Date
  /// Payment terms in days from receipt (Net 30 = 30); paymentDueDate overrides when set.
  paymentTermsDays Int?
  paymentDueDate DateTime?           @db.Date
  prepayments    SupplierPrepayment[]
  attachments    BusinessFile[]
}

model PurchaseOrderLine {
  id               String         @id @default(cuid())
  orderId          String
  order            PurchaseOrder  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId        String
  variantId        String?
  variant          ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  quantity         Int
  quantityReceived Int            @default(0)
  unitCost         Int

  @@index([orderId])
}

model SupplierBill {
  id             String             @id @default(cuid())
  organizationId String
  organization   Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  supplierId     String
  supplier       Supplier           @relation(fields: [supplierId], references: [id])
  purchaseOrderId String?
  purchaseOrder  PurchaseOrder?     @relation(fields: [purchaseOrderId], references: [id], onDelete: SetNull)
  amount         Int
  amountPaid     Int                @default(0)
  status         SupplierBillStatus @default(OPEN)
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  payments       SupplierPayment[]

  @@index([organizationId, supplierId, status])
  /// GOODS (raised on receipt) or FREIGHT (freight company, landed cost on the order).
  kind           SupplierBillKind   @default(GOODS)
  dueDate        DateTime?          @db.Date
  reference      String?
  note           String?
  proofFileId    String?
  proofFile      BusinessFile?      @relation("BillProof", fields: [proofFileId], references: [id], onDelete: Restrict)
  /// FREIGHT: [{ lineId, amount }] share of each order line (by line value).
  freightAllocation Json?
  /// FREIGHT: dirhams added to stock unit cost so far / charged as freight on goods already sold.
  freightCapitalised Int            @default(0)
  freightExpensed Int               @default(0)
  userId         String?
  prepaymentApplications SupplierPrepaymentApplication[]
}

model SupplierPayment {
  id        String            @id @default(cuid())
  billId    String
  bill      SupplierBill      @relation(fields: [billId], references: [id], onDelete: Cascade)
  amount    Int
  method    SupplierPayMethod
  paidAt    DateTime          @default(now())
  userId    String
  user      User              @relation(fields: [userId], references: [id])
  note      String?
  reference String?
  proofFileId String?
  proofFile BusinessFile? @relation("SupplierPaymentProof", fields: [proofFileId], references: [id], onDelete: Restrict)
}

model StockMovement {
  id             String          @id @default(cuid())
  organizationId String
  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  productId      String
  product        Product         @relation(fields: [productId], references: [id])
  variantId      String?
  variant        ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  branchId       String
  branch         Branch          @relation(fields: [branchId], references: [id])
  quantityDelta  Int
  reason         StockMoveReason
  note           String?
  userId         String?
  user           User?           @relation(fields: [userId], references: [id], onDelete: SetNull)
  /// Transfer record this movement belongs to (TRANSFER rows made since transfer records exist).
  transferId     String?
  transfer       StockTransfer?  @relation(fields: [transferId], references: [id], onDelete: SetNull)
  /// Van return this RETURN movement belongs to.
  vanReturnId    String?
  vanReturn      VanReturn?      @relation(fields: [vanReturnId], references: [id], onDelete: SetNull)
  createdAt      DateTime        @default(now())

  @@index([organizationId, branchId, createdAt])
  @@index([productId])
  /// SALE movement of a sales-order delivery.
  salesOrderId   String?
  salesOrder     SalesOrder?     @relation(fields: [salesOrderId], references: [id], onDelete: Restrict)

  @@index([transferId])
  @@index([vanReturnId])
}

model StockHold {
  id             String         @id @default(cuid())
  organizationId String
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  saleId         String
  sale           Sale           @relation(fields: [saleId], references: [id], onDelete: Cascade)
  productId      String
  product        Product        @relation(fields: [productId], references: [id])
  variantId      String?
  variant        ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  branchId       String
  branch         Branch         @relation(fields: [branchId], references: [id])
  quantity       Int
  windowId       String?
  window         DeliveryWindow? @relation(fields: [windowId], references: [id], onDelete: SetNull)
  status         HoldStatus     @default(HELD)
  expiresAt      DateTime
  releasedAt     DateTime?
  createdAt      DateTime       @default(now())

  @@index([saleId, status])
  @@index([branchId, productId, status])
}

model DeliveryArea {
  id             String       @id @default(cuid())
  /// NFR-13: optimistic-lock version, bumped on every write
  version Int @default(1)
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  nameEn         String?
  city           String?
  fee            Int          @default(0)
  isActive       Boolean      @default(true)
  sales          Sale[]
  appointments   Appointment[]
  createdAt      DateTime     @default(now())
}

model DeliveryWindow {
  id             String       @id @default(cuid())
  /// NFR-13: optimistic-lock version, bumped on every write
  version Int @default(1)
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  label          String
  labelEn        String?
  /// 0 = Sunday … 6 = Saturday. Null means any day.
  weekday        Int?
  startTime      String
  endTime        String
  seats          Int          @default(4)
  isActive       Boolean      @default(true)
  sales          Sale[]
  holds          StockHold[]
  createdAt      DateTime     @default(now())
}

model CustomerPet {
  id             String       @id @default(cuid())
  /// NFR-13: optimistic-lock version, bumped on every write
  version Int @default(1)
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customerId     String
  customer       Customer     @relation(fields: [customerId], references: [id], onDelete: Cascade)
  petTypeId      String?
  petType        CatalogPetType? @relation(fields: [petTypeId], references: [id], onDelete: SetNull)
  name           String
  breed          String?
  ageText        String?
  /// Staff only. Never returned to the customer account.
  notes          String?
  createdAt      DateTime     @default(now())
  relocationLinks RelocationPet[]

  @@index([customerId])
}

model CustomerAddress {
  id         String   @id @default(cuid())
  /// NFR-13: optimistic-lock version, bumped on every write
  version Int @default(1)
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  label      String?
  line1      String
  area       String?
  city       String?
  lat        Decimal?
  lng        Decimal?
  isDefault  Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@index([customerId])
}

model GroomingSchedule {
  id             String       @id @default(cuid())
  /// NFR-13: optimistic-lock version, bumped on every write
  version Int @default(1)
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  /// 0 = Sunday … 6 = Saturday.
  weekday        Int
  startTime      String
  endTime        String
  capacity       Int          @default(1)
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now())

  @@index([organizationId, weekday])
}

model GroomingPackagePet {
  serviceId String
  petTypeId String
  service   GroomingService @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  petType   CatalogPetType  @relation(fields: [petTypeId], references: [id], onDelete: Cascade)

  @@id([serviceId, petTypeId])
}

model RelocationRequest {
  id             String           @id @default(cuid())
  /// NFR-13: optimistic-lock version, bumped on every write
  version Int @default(1)
  organizationId String
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customerId     String
  customer       Customer         @relation(fields: [customerId], references: [id], onDelete: Cascade)
  destination    String
  petSummary     String?
  status         RelocationStatus @default(SUBMITTED)
  quoteAmount    Int?
  quoteNote      String?
  /// Hidden from the customer.
  staffNotes     String?
  history        Json?
  paymentMethod  String?
  gatewayPaymentId String?
  paidAt         DateTime?
  amountPaid     Int              @default(0)
  paymentReview  Boolean          @default(false)
  paymentReviewReason String?
  /// Short human reference customers and staff quote (NFR-22).
  reference      String?  @unique @default(dbgenerated("nc_ref('NC-REL-'::text, 'nc_relocation_ref_seq'::regclass)"))
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  pets           RelocationPet[]
  documents      RelocationDocument[]
  payments       Payment[]

  @@index([organizationId, status])
  @@index([customerId])
}

model RelocationPet {
  requestId String
  petId     String
  request   RelocationRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  pet       CustomerPet       @relation(fields: [petId], references: [id], onDelete: Cascade)

  @@id([requestId, petId])
}

model RelocationDocument {
  id         String            @id @default(cuid())
  requestId  String
  request    RelocationRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  fileName   String
  mime       String
  /// Bytes kept in the database (storage disabled, or not yet moved). Null when the file lives only in Supabase Storage.
  content    Bytes?
  /// Object key in the private Supabase "relocation-documents" bucket.
  storagePath String?
  size       Int?
  createdAt  DateTime          @default(now())

  @@index([requestId])
}

/// A direct browser upload to Supabase Storage waiting to be confirmed (checked) and attached to a request.
/// Rows left over after 24 h are removed with their objects by the daily cron.
model RelocationUpload {
  id             String    @id @default(cuid())
  organizationId String
  customerId     String
  storagePath    String    @unique
  fileName       String
  mime           String
  size           Int?
  verifiedAt     DateTime?
  createdAt      DateTime  @default(now())

  @@index([customerId])
  @@index([createdAt])
}

model Promotion {
  id             String        @id @default(cuid())
  /// NFR-13: optimistic-lock version, bumped on every write
  version Int @default(1)
  organizationId String
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  nameEn         String?
  kind           PromotionKind
  code           String?
  percent        Decimal?
  amount         Int?
  productId      String?
  product        Product?      @relation(fields: [productId], references: [id], onDelete: SetNull)
  categoryId     String?
  category       Category?     @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  buyQty         Int?
  getQty         Int?
  bundleProductIds Json?
  bundlePrice    Int?
  minOrderAmount Int?
  startsAt       DateTime      @default(now())
  endsAt         DateTime?
  active         Boolean       @default(true)
  channel        PromoChannel  @default(ALL)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([organizationId, active])
}

model Vehicle {
  id             String       @id @default(cuid())
  /// NFR-13: optimistic-lock version, bumped on every write
  version Int @default(1)
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  plate          String
  branchId       String?      @unique
  branch         Branch?      @relation(fields: [branchId], references: [id], onDelete: SetNull)
  isActive       Boolean      @default(true)
  notes          String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  transfers      StockTransfer[]
  vanReturns     VanReturn[]

  @@index([organizationId, isActive])
}

/// Money received or returned for exactly one order, booking or relocation quote ("One payment parent").
model Payment {
  id                  String             @id @default(cuid())
  organizationId      String
  saleId              String?
  sale                Sale?              @relation(fields: [saleId], references: [id], onDelete: Restrict)
  appointmentId       String?
  appointment         Appointment?       @relation(fields: [appointmentId], references: [id], onDelete: Restrict)
  relocationRequestId String?
  relocationRequest   RelocationRequest? @relation(fields: [relocationRequestId], references: [id], onDelete: Restrict)
  /// PAYMENT or REFUND.
  kind                String             @default("PAYMENT")
  /// ONLINE, CASH or BANK.
  method              String
  /// CAPTURED, REVIEW (staff must resolve), REJECTED (refunded after review), PENDING (refund in flight).
  status              String             @default("CAPTURED")
  amount              Int
  currency            String             @default("QAR")
  reference           String?
  gatewayPaymentId    String?
  gatewayRefundId     String?
  reviewReason        String?
  /// Staff user who recorded it (null for gateway notifications).
  userId              String?
  note                String?
  createdAt           DateTime           @default(now())

  @@index([saleId])
  @@index([appointmentId])
  @@index([relocationRequestId])
  @@index([organizationId, status])
}

/// FR-76: server-side SkipCash status lookups (customer return, staff check, expiry sweep).
/// A partial unique index (raw SQL) allows one "sweep" row per gateway payment: the expiry
/// sweep looks a pending payment up once before it releases the hold.
model GatewayLookup {
  id               String   @id @default(cuid())
  parentKind       String
  parentId         String
  gatewayPaymentId String
  /// sweep, return or staff.
  source           String
  statusId         Int?
  outcome          String?
  error            String?
  createdAt        DateTime @default(now())

  @@index([gatewayPaymentId])
  @@index([parentKind, parentId])
}

/// Transactional email waiting to be sent. Rows are written in the caller's flow and sent by
/// the outbox worker with retry and backoff, so a mail failure never fails the business action.
model EmailOutbox {
  id             String    @id @default(cuid())
  organizationId String?
  kind           String
  toEmail        String
  subject        String
  text           String
  html           String?
  /// PENDING | SENDING | SENT | FAILED
  status         String    @default("PENDING")
  attempts       Int       @default(0)
  nextAttemptAt  DateTime  @default(now())
  lockedUntil    DateTime?
  lastError      String?
  sentAt         DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([status, nextAttemptAt])
}

/// Demo data (scripts/demo-data.mjs): one row per database row the demo loader created, so
/// `remove` deletes exactly those rows. entityType is the table name; "_load" rows hold the
/// loader's own state (organization, previous website location, status).
model DemoRecord {
  id         String   @id @default(cuid())
  entityType String
  entityId   String
  meta       Json?
  createdAt  DateTime @default(now())

  @@unique([entityType, entityId])
}

// ───────────────────────── Sales orders, supplier prepayments, freight, files ─────────────────────────

enum SupplierBillKind {
  GOODS
  FREIGHT
}

enum SalesOrderStatus {
  DRAFT
  CONFIRMED
  PARTLY_DELIVERED
  DELIVERED
  COMPLETED
  CANCELLED
}

/// B2B / project order: paid by installments, stock leaves at delivery (revenue and cost at delivery).
model SalesOrder {
  id               String                  @id @default(cuid())
  /// NFR-13: optimistic-lock version, bumped on every write
  version          Int                     @default(1)
  organizationId   String
  organization     Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  /// Short reference staff and customers quote (NC-SO-000001).
  reference        String                  @unique @default(dbgenerated("nc_ref('NC-SO-'::text, 'nc_sales_order_ref_seq'::regclass)"))
  customerId       String
  customer         Customer                @relation(fields: [customerId], references: [id], onDelete: Restrict)
  branchId         String
  branch           Branch                  @relation(fields: [branchId], references: [id], onDelete: Restrict)
  userId           String
  user             User                    @relation(fields: [userId], references: [id], onDelete: Restrict)
  status           SalesOrderStatus        @default(DRAFT)
  deliveryDate     DateTime?               @db.Date
  note             String?
  /// Payment terms label (e.g. "50% now, 50% in 14 days") and default days.
  paymentTerms     String?
  paymentTermsDays Int?
  /// Sum of paid line amounts before the order discount (dirhams).
  subtotal         Int                     @default(0)
  discountAmount   Int                     @default(0)
  total            Int                     @default(0)
  amountPaid       Int                     @default(0)
  /// Revenue recognised so far (delivered value).
  deliveredRevenue Int                     @default(0)
  freeReason       String?
  confirmedAt      DateTime?
  completedAt      DateTime?
  cancelledAt      DateTime?
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt
  lines            SalesOrderLine[]
  installments     SalesOrderInstallment[]
  payments         SalesOrderPayment[]
  deliveries       SalesOrderDelivery[]
  stockMovements   StockMovement[]

  @@index([organizationId, status])
  @@index([customerId])
}

model SalesOrderLine {
  id                String                   @id @default(cuid())
  orderId           String
  order             SalesOrder               @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId         String
  product           Product                  @relation(fields: [productId], references: [id], onDelete: Restrict)
  variantId         String?
  variant           ProductVariant?          @relation(fields: [variantId], references: [id], onDelete: Restrict)
  sortOrder         Int                      @default(0)
  /// Pieces, or grams for weight goods.
  quantity          Int
  quantityDelivered Int                      @default(0)
  /// Current catalogue price when the line was written; unitPrice may differ (manager override).
  listPrice         Int
  unitPrice         Int
  /// quantity × unitPrice (0 on a free line).
  subtotal          Int
  /// Share of the order discount.
  discountShare     Int                      @default(0)
  isFree            Boolean                  @default(false)
  deliveryLines     SalesOrderDeliveryLine[]

  @@index([orderId])
}

model SalesOrderInstallment {
  id         String     @id @default(cuid())
  orderId    String
  order      SalesOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  seq        Int
  /// Percent of the total when the plan was given in percent (the amount is authoritative).
  percent    Decimal?   @db.Decimal(7, 3)
  amount     Int
  dueDate    DateTime   @db.Date
  amountPaid Int        @default(0)

  @@unique([orderId, seq])
}

model SalesOrderPayment {
  id          String        @id @default(cuid())
  orderId     String
  order       SalesOrder    @relation(fields: [orderId], references: [id], onDelete: Restrict)
  branchId    String
  branch      Branch        @relation(fields: [branchId], references: [id], onDelete: Restrict)
  amount      Int
  method      PaymentMethod
  reference   String?
  note        String?
  paidAt      DateTime      @default(now())
  proofFileId String?
  proofFile   BusinessFile? @relation("SalesOrderPaymentProof", fields: [proofFileId], references: [id], onDelete: Restrict)
  /// [{ installmentId, seq, amount }] how this payment was spread over the installments (oldest first).
  allocation  Json?
  userId      String
  user        User          @relation(fields: [userId], references: [id], onDelete: Restrict)
  createdAt   DateTime      @default(now())

  @@index([orderId])
}

model SalesOrderDelivery {
  id                String                   @id @default(cuid())
  orderId           String
  order             SalesOrder               @relation(fields: [orderId], references: [id], onDelete: Restrict)
  branchId          String
  branch            Branch                   @relation(fields: [branchId], references: [id], onDelete: Restrict)
  userId            String
  user              User                     @relation(fields: [userId], references: [id], onDelete: Restrict)
  note              String?
  /// Revenue recognised by this delivery, cost of the paid lines, cost of the free lines.
  revenue           Int                      @default(0)
  cost              Int                      @default(0)
  complimentaryCost Int                      @default(0)
  deliveredAt       DateTime                 @default(now())
  lines             SalesOrderDeliveryLine[]

  @@index([orderId])
}

model SalesOrderDeliveryLine {
  id         String             @id @default(cuid())
  deliveryId String
  delivery   SalesOrderDelivery @relation(fields: [deliveryId], references: [id], onDelete: Cascade)
  lineId     String
  line       SalesOrderLine     @relation(fields: [lineId], references: [id], onDelete: Restrict)
  quantity   Int
  revenue    Int
  unitCost   Int
  costAmount Int
  isFree     Boolean            @default(false)

  @@index([deliveryId])
}

/// Money paid to a supplier against a purchase order before (or without) a bill. Applied to the
/// order's goods bills when goods are received (SupplierPrepaymentApplication); never a SupplierPayment.
model SupplierPrepayment {
  id              String                          @id @default(cuid())
  organizationId  String
  organization    Organization                    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  supplierId      String
  supplier        Supplier                        @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  purchaseOrderId String
  purchaseOrder   PurchaseOrder                   @relation(fields: [purchaseOrderId], references: [id], onDelete: Restrict)
  amount          Int
  amountApplied   Int                             @default(0)
  method          SupplierPayMethod
  reference       String?
  note            String?
  paidAt          DateTime                        @default(now())
  proofFileId     String?
  proofFile       BusinessFile?                   @relation("PrepaymentProof", fields: [proofFileId], references: [id], onDelete: Restrict)
  userId          String
  user            User                            @relation(fields: [userId], references: [id], onDelete: Restrict)
  createdAt       DateTime                        @default(now())
  applications    SupplierPrepaymentApplication[]

  @@index([organizationId, supplierId])
  @@index([purchaseOrderId])
}

model SupplierPrepaymentApplication {
  id           String             @id @default(cuid())
  prepaymentId String
  prepayment   SupplierPrepayment @relation(fields: [prepaymentId], references: [id], onDelete: Cascade)
  billId       String
  bill         SupplierBill       @relation(fields: [billId], references: [id], onDelete: Cascade)
  amount       Int
  createdAt    DateTime           @default(now())

  @@index([billId])
}

/// Private business document: PO quotation / invoice attachment or a payment proof (JPEG, PNG, WebP, PDF, at most 10 MB).
model BusinessFile {
  id                      String                  @id @default(cuid())
  organizationId          String
  organization            Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  /// PO_ATTACHMENT or PAYMENT_PROOF.
  purpose                 String
  purchaseOrderId         String?
  purchaseOrder           PurchaseOrder?          @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  fileName                String
  mime                    String
  size                    Int
  /// Bytes kept in the database when Supabase Storage is not configured.
  content                 Bytes?
  /// Object key in the private "business-documents" bucket.
  storagePath             String?
  uploadedByUserId        String?
  uploadedBy              User?                   @relation(fields: [uploadedByUserId], references: [id], onDelete: SetNull)
  createdAt               DateTime                @default(now())
  ledgerProofs            CustomerAccountLedger[] @relation("LedgerProof")
  billProofs              SupplierBill[]          @relation("BillProof")
  supplierPaymentProofs   SupplierPayment[]       @relation("SupplierPaymentProof")
  salesOrderPaymentProofs SalesOrderPayment[]     @relation("SalesOrderPaymentProof")
  prepaymentProofs        SupplierPrepayment[]    @relation("PrepaymentProof")

  @@index([organizationId, purpose])
  @@index([purchaseOrderId])
}

/// Unit a transfer or van-return line was entered in. Stock itself is always pieces (or grams for weight goods).
enum StockUnit {
  /// One piece (a bag for pack-size variants).
  PIECE
  /// A carton of `piecesPerCarton` pieces.
  CARTON
  /// Kilograms of a weight product (stored as grams).
  KG
}

/// One-step stock transfer between two locations (stock moves when it is saved).
model StockTransfer {
  id                  String              @id @default(cuid())
  organizationId      String
  organization        Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  /// Human reference, e.g. TR-000123.
  reference           String?             @unique @default(dbgenerated("nc_ref('TR-'::text, 'nc_transfer_ref_seq'::regclass)"))
  fromBranchId        String
  fromBranch          Branch              @relation("StockTransferFrom", fields: [fromBranchId], references: [id])
  toBranchId          String
  toBranch            Branch              @relation("StockTransferTo", fields: [toBranchId], references: [id])
  createdByUserId     String
  createdBy           User                @relation("StockTransferCreatedBy", fields: [createdByUserId], references: [id])
  transferredByUserId String?
  transferredBy       User?               @relation("StockTransferTransferredBy", fields: [transferredByUserId], references: [id], onDelete: SetNull)
  authorisedByUserId  String?
  authorisedBy        User?               @relation("StockTransferAuthorisedBy", fields: [authorisedByUserId], references: [id], onDelete: SetNull)
  vehicleId           String?
  vehicle             Vehicle?            @relation(fields: [vehicleId], references: [id], onDelete: SetNull)
  /// Vehicle name and plate when the transfer was made (later edits do not rewrite history).
  vehicleName         String?
  vehiclePlate        String?
  note                String?
  createdAt           DateTime            @default(now())
  lines               StockTransferLine[]
  movements           StockMovement[]

  @@index([organizationId, createdAt])
  @@index([fromBranchId])
  @@index([toBranchId])
}

model StockTransferLine {
  id              String          @id @default(cuid())
  transferId      String
  transfer        StockTransfer   @relation(fields: [transferId], references: [id], onDelete: Cascade)
  productId       String
  product         Product         @relation(fields: [productId], references: [id])
  variantId       String?
  variant         ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  unit            StockUnit
  /// Quantity as entered in `unit` (kg may have decimals).
  enteredQty      Decimal         @db.Decimal(12, 3)
  /// Pieces per carton used for a CARTON line.
  piecesPerCarton Int?
  /// Quantity in stock units: pieces, or grams for weight goods.
  baseQty         Int
  /// Source unit cost when moved (whole dirhams per piece, or per kg for weight goods).
  unitCost        Int?
  /// Value moved (whole dirhams): baseQty x unitCost, grams x cost per kg / 1000 for weight goods.
  lineValue       Int             @default(0)
  fromBefore      Int
  fromAfter       Int
  toBefore        Int
  toAfter         Int

  @@index([transferId])
  @@index([productId])
}

enum VanReturnStatus {
  /// Collected from the customer, still in the van (not sellable stock).
  IN_VAN
  /// Converted into a warehouse return at the main store.
  RECEIVED
}

enum ReturnCondition {
  GOOD
  DAMAGED
}

enum VanReturnPayStatus {
  UNPAID
  PAID
}

/// How money moved for a van return payment (cash, bank) or a damaged-stock sale (also card).
enum ReturnMoneyMethod {
  CASH
  BANK
  CARD
}

/// Goods a van driver collected back from a customer. Not a till refund.
model VanReturn {
  id                  String             @id @default(cuid())
  /// NFR-13: optimistic-lock version, bumped on every write
  version             Int                @default(1)
  organizationId      String
  organization        Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  /// Human reference, e.g. VR-000045.
  reference           String?            @unique @default(dbgenerated("nc_ref('VR-'::text, 'nc_van_return_ref_seq'::regclass)"))
  status              VanReturnStatus    @default(IN_VAN)
  vanBranchId         String
  vanBranch           Branch             @relation("VanReturnVan", fields: [vanBranchId], references: [id])
  vehicleId           String?
  vehicle             Vehicle?           @relation(fields: [vehicleId], references: [id], onDelete: SetNull)
  vehicleName         String?
  vehiclePlate        String?
  customerId          String?
  customer            Customer?          @relation(fields: [customerId], references: [id], onDelete: SetNull)
  customerName        String?
  customerPhone       String?
  collectedByUserId   String
  collectedBy         User               @relation("VanReturnCollectedBy", fields: [collectedByUserId], references: [id])
  createdByUserId     String
  createdBy           User               @relation("VanReturnCreatedBy", fields: [createdByUserId], references: [id])
  collectedAt         DateTime           @default(now())
  /// Owed to the customer, whole dirhams (0 allowed).
  amountOwed          Int                @default(0)
  note                String?
  paymentStatus       VanReturnPayStatus @default(UNPAID)
  paidMethod          ReturnMoneyMethod?
  paidReference       String?
  paidByUserId        String?
  paidBy              User?              @relation("VanReturnPaidBy", fields: [paidByUserId], references: [id], onDelete: SetNull)
  paidAt              DateTime?
  /// Van till session the cash left from (cash payments only). Expected cash at close subtracts it.
  cashSessionId       String?
  cashSession         CashSession?       @relation(fields: [cashSessionId], references: [id], onDelete: SetNull)
  receivedBranchId    String?
  receivedBranch      Branch?            @relation("VanReturnReceivedAt", fields: [receivedBranchId], references: [id])
  receivedAt          DateTime?
  broughtBackByUserId String?
  broughtBackBy       User?              @relation("VanReturnBroughtBackBy", fields: [broughtBackByUserId], references: [id], onDelete: SetNull)
  receivedByUserId    String?
  receivedBy          User?              @relation("VanReturnReceivedBy", fields: [receivedByUserId], references: [id], onDelete: SetNull)
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
  lines               VanReturnLine[]
  photos              VanReturnPhoto[]
  paymentProof        VanReturnPaymentProof?
  movements           StockMovement[]
  damagedStocks       DamagedStock[]

  @@index([organizationId, status])
  @@index([vanBranchId, createdAt])
  @@index([receivedAt])
  @@index([paidAt])
  @@index([cashSessionId])
}

model VanReturnLine {
  id              String          @id @default(cuid())
  vanReturnId     String
  vanReturn       VanReturn       @relation(fields: [vanReturnId], references: [id], onDelete: Cascade)
  productId       String
  product         Product         @relation(fields: [productId], references: [id])
  variantId       String?
  variant         ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  unit            StockUnit
  enteredQty      Decimal         @db.Decimal(12, 3)
  piecesPerCarton Int?
  /// Pieces, or grams for weight goods.
  baseQty         Int
  condition       ReturnCondition
  /// Evidence photo (required for a damaged line).
  photoId         String?
  photo           VanReturnPhoto? @relation(fields: [photoId], references: [id], onDelete: SetNull)
  /// Cost per unit at receipt (whole dirhams; per kg for weight goods).
  unitCost        Int?
  /// Cost reversed at receipt (whole dirhams).
  costAmount      Int?
  damagedStock    DamagedStock?

  @@index([vanReturnId])
  @@index([productId])
}

/// Evidence photo of a returned line, re-encoded as WebP without metadata. Private.
model VanReturnPhoto {
  id             String          @id @default(cuid())
  organizationId String
  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  vanReturnId    String
  vanReturn      VanReturn       @relation(fields: [vanReturnId], references: [id], onDelete: Cascade)
  mime           String
  size           Int
  width          Int?
  height         Int?
  /// Bytes in the database when file storage is off.
  content        Bytes?
  /// Object key in the private "van-return-photos" bucket.
  storagePath    String?
  createdAt      DateTime        @default(now())
  lines          VanReturnLine[]
  damagedStocks  DamagedStock[]

  @@index([vanReturnId])
}

enum DamagedStockStatus {
  /// Kept out of sale, waiting for the owner.
  HELD
  WRITTEN_OFF
  SOLD
}

/// Damaged goods from a received van return. Never part of sellable stock.
model DamagedStock {
  id               String             @id @default(cuid())
  /// NFR-13: optimistic-lock version, bumped on every write
  version          Int                @default(1)
  organizationId   String
  organization     Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  vanReturnId      String
  vanReturn        VanReturn          @relation(fields: [vanReturnId], references: [id])
  vanReturnLineId  String             @unique
  vanReturnLine    VanReturnLine      @relation(fields: [vanReturnLineId], references: [id])
  /// Where the damaged goods are kept.
  branchId         String
  branch           Branch             @relation(fields: [branchId], references: [id])
  productId        String
  product          Product            @relation(fields: [productId], references: [id])
  variantId        String?
  variant          ProductVariant?    @relation(fields: [variantId], references: [id], onDelete: SetNull)
  /// Pieces, or grams for weight goods.
  quantity         Int
  unitCost         Int?
  /// Cost of the goods (whole dirhams).
  costAmount       Int                @default(0)
  photoId          String?
  photo            VanReturnPhoto?    @relation(fields: [photoId], references: [id], onDelete: SetNull)
  status           DamagedStockStatus @default(HELD)
  /// Reduced-price sale: amount (whole dirhams) and how it was paid.
  saleAmount       Int?
  saleMethod       ReturnMoneyMethod?
  resolvedAt       DateTime?
  resolvedByUserId String?
  resolvedBy       User?              @relation("DamagedStockResolvedBy", fields: [resolvedByUserId], references: [id], onDelete: SetNull)
  resolveNote      String?
  createdAt        DateTime           @default(now())

  @@index([organizationId, status])
  @@index([branchId])
  @@index([resolvedAt])
}

/// Proof of a van-return payment (required for a bank transfer, optional for cash). Private.
/// Images are re-encoded as WebP without metadata; PDFs are kept as sent (checked by their bytes).
model VanReturnPaymentProof {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  vanReturnId    String       @unique
  vanReturn      VanReturn    @relation(fields: [vanReturnId], references: [id], onDelete: Cascade)
  fileName       String
  mime           String
  size           Int
  /// Bytes in the database when file storage is off.
  content        Bytes?
  /// Object key in the private "van-return-proofs" bucket.
  storagePath    String?
  createdAt      DateTime     @default(now())
}
