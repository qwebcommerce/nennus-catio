generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

/// مجال النشاط التجاري (يُختار عند إنشاء المؤسسة أو التسجيل الذاتي)
enum BusinessVertical {
  GROCERY
  RESTAURANT
  CAFE
  PHONE_STORE
  AUTO_DEALER
  BOOKING_SERVICES
  RETAIL_GENERAL
  PHARMACY
  CLOTHING
  HARDWARE_ELECTRONICS
  BEAUTY_SALON
  PET_STORE
  HOTEL
  FITNESS
  WHOLESALE
  SERVICES_OTHER
}

/// مستأجر SaaS — عزل منطقي داخل نفس قاعدة PostgreSQL
model Organization {
  id        String   @id @default(cuid())
  name      String
  /// للدخول عند تعدد المؤسسات: نفس البريد + slug
  slug      String?  @unique
  /// نشاط المنشأة (بقالة، مطعم، …)
  businessVertical BusinessVertical?
  /// FREE | PREMIUM — يتحكم بحد الفروع والميزات لاحقاً
  plan             String   @default("FREE")
  /// أقصى عدد فروع حسب الخطة (الافتراضي 3 للخطة المجانية)
  maxBranches      Int      @default(3)
  /// صلاحيات دور المدير (JSON object of permissionKey → boolean)
  managerPermissions String?
  /// صلاحيات دور الموظف/الكاشير (JSON)
  cashierPermissions String?
  /// هل يُسمح لبائع الأرضية بإتمام الدفع من الجوال (وإلا يُرسل السلة للكاشير)
  associateCanAcceptPayment Boolean @default(true)
  /// The one location the website sells from. Never a van.
  websiteBranchId String?
  websiteBranch   Branch? @relation("OrgWebsiteBranch", fields: [websiteBranchId], references: [id], onDelete: SetNull)
  /// How long a website payment hold lasts, in minutes.
  holdMinutes Int @default(20)
  /// Business WhatsApp for a custom pet-house enquiry. Digits only, country code included.
  whatsappNumber String?
  /// Added to a grooming booking when the customer chooses a home visit.
  homeVisitFee Decimal @default(0)
  /// A customer may cancel a grooming booking up to this many hours before it starts.
  bookingCancelHours Int @default(24)
  phone           String?
  publicEmail     String?
  publicAddress   String?
  hoursText       String?
  hoursTextEn     String?
  notifyEmail     String?
  alertOrder      Boolean @default(true)
  alertBooking    Boolean @default(true)
  alertRelocation Boolean @default(true)
  alertLowStock   Boolean @default(false)
  /// Module rights for manager and cashier. Admin always has every action.
  managerModules  String?
  cashierModules  String?

  /// Onboarding: account created → profile/docs → Stripe payment → complete
  profileDocsDone Boolean @default(false)
  paymentDone     Boolean @default(false)

  /// Legal / KYC profile (Gulf businesses)
  legalName             String?
  country               String?
  city                  String?
  addressText           String?
  crNumber              String?
  licenseNumber         String?
  ownerFullName         String?
  ownerIdNumber         String?
  ownerPhone            String?
  vatNumber             String?
  taxNumber             String?
  iban                  String?
  authorizedPersonName  String?
  termsAcceptedAt       DateTime?

  /// Platform KYC review: NOT_SUBMITTED | PENDING_REVIEW | APPROVED | REJECTED
  onboardingReviewStatus String    @default("NOT_SUBMITTED")
  onboardingReviewedAt   DateTime?
  onboardingReviewedBy   String?
  onboardingReviewNote   String?

  /// Stripe billing
  stripeCustomerId     String?
  stripeSubscriptionId String?
  selectedPlanInterval String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users                    User[]
  branches                 Branch[]
  planPurchases            OrganizationPlanPurchase[]
  onboardingDocuments      OrganizationDocument[]
  productImages            ProductImage[]
  products                 Product[]
  brands                   Brand[]
  categories               Category[]
  subcategories            Subcategory[]
  catalogSkus              CatalogSku[]
  customers                Customer[]
  suppliers                Supplier[]
  syncSettings             SyncSettings?
  taxSettings              OrganizationTaxSettings?
  offlineInventoryReceipts OfflineInventoryReceipt[]
  notificationReads       NotificationRead[]
  loyaltyProgramSettings  LoyaltyProgramSettings?
  coupons                 Coupon[]
  loyaltyLedgers          LoyaltyLedger[]
  employees               Employee[]
  payrollPeriods          PayrollPeriod[]
  employeeLoans           EmployeeLoan[]
  customerAccountLedgers  CustomerAccountLedger[]
  expenses                Expense[]
  groomingServices        GroomingService[]
  appointments            Appointment[]
  accounts                Account[]
  journalEntries          JournalEntry[]
  journalLines            JournalLine[]
  automationRules         AutomationRule[]
  automationRuns          AutomationRun[]
  automationLogs          AutomationLog[]
  commissionRules         CommissionRule[]
  commissionEntries       CommissionEntry[]
  deliveryOrders          DeliveryOrder[]
  deliveryRoutes          DeliveryRoute[]
  deliveryStops           DeliveryStop[]
  inventoryLots           InventoryLot[]
  purchaseDrafts          PurchaseDraft[]
  promoDrafts             PromoDraft[]
  saleItemLots            SaleItemLot[]
  catalogPetTypes         CatalogPetType[]
  productVariants         ProductVariant[]
  purchaseOrders          PurchaseOrder[]
  supplierBills           SupplierBill[]
  stockMovements          StockMovement[]
  stockHolds              StockHold[]
  deliveryAreas           DeliveryArea[]
  deliveryWindows         DeliveryWindow[]
  customerPets            CustomerPet[]
  groomingSchedules       GroomingSchedule[]
  relocationRequests      RelocationRequest[]
  promotions              Promotion[]
  vehicles                Vehicle[]
}

/// GCC VAT / tax pack per organization (default rate + receipt currency)
model OrganizationTaxSettings {
  id               String       @id @default(cuid())
  organizationId   String       @unique
  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  /// QA | SA | AE | KW | BH | OM
  countryCode      String       @default("QA")
  /// SAR | QAR | AED | KWD | BHD | OMR
  currency         String       @default("QAR")
  /// Standard VAT percent applied at POS (e.g. 15, 5, 0)
  standardRate     Decimal      @default(0)
  pricesIncludeTax Boolean      @default(false)
  enabled          Boolean      @default(true)
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
}

/// Uploaded KYC / business documents for organization onboarding
model OrganizationDocument {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  /// CR | OWNER_ID | VAT | LICENSE | IBAN
  docType        String
  fileName       String
  mimeType       String
  size           Int
  data           Bytes
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([organizationId, docType])
  @@index([organizationId])
}

/// Product photos stored in the database (no external object storage required)
model ProductImage {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  /// Set when the image is attached to a product (may be null right after upload)
  productId      String?
  product        Product?     @relation(fields: [productId], references: [id], onDelete: Cascade)
  fileName       String
  mimeType       String
  size           Int
  data           Bytes
  createdAt      DateTime     @default(now())

  @@index([organizationId])
  @@index([productId])
}

/// Organization subscription purchases and renewals shown in the Plan page.
model OrganizationPlanPurchase {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  plan           String
  amount         Decimal?
  currency       String       @default("SAR")
  reference      String?
  note           String?
  purchasedAt    DateTime     @default(now())
  createdAt      DateTime     @default(now())

  @@index([organizationId, purchasedAt])
}

/// فئات مصاريف تشغيلية قابلة للتوسعة
enum ExpenseCategory {
  RENT
  PAYROLL
  ELECTRICITY
  INTERNET
  OTHER
}

/// مصروف مسجّل (يومية / شهرية — حسب تاريخ الانتماء)
model Expense {
  id               String          @id @default(cuid())
  organizationId   String
  organization     Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  category         ExpenseCategory
  amount           Decimal
  description      String?
  /// تاريخ انتماء المصروف للتقارير (يوم/شهر/سنة)
  expenseDate      DateTime
  createdByUserId  String
  createdBy        User            @relation("ExpenseCreatedBy", fields: [createdByUserId], references: [id])
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  @@index([organizationId, expenseDate])
  @@index([organizationId, category])
}

enum EmployeeStatus {
  ACTIVE
  ON_LEAVE
  TERMINATED
}

enum PayrollPeriodStatus {
  DRAFT
  APPROVED
  PAID
}

enum EmployeeLoanStatus {
  OPEN
  SETTLED
}

enum AppointmentStatus {
  BOOKED
  PENDING_PAYMENT
  CONFIRMED
  CHECKED_IN
  IN_PROGRESS
  DONE
  NO_SHOW
  CANCELLED
}

enum VisitKind {
  SHOP
  HOME
}

enum RelocationStatus {
  SUBMITTED
  DOCUMENTS_REQUESTED
  DOCUMENTS_RECEIVED
  UNDER_REVIEW
  QUOTE_SENT
  PAID
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum ReminderChannel {
  SMS
  EMAIL
  WHATSAPP
}

enum ReminderStatus {
  PENDING
  SENT
  FAILED
}

enum AutomationTrigger {
  INACTIVE_CUSTOMERS
  MISSED_APPOINTMENTS
}

enum AutomationChannel {
  SMS
  EMAIL
  WHATSAPP
}

enum CommissionBase {
  APPOINTMENT_SERVICE_AMOUNT
}

enum DeliveryStatus {
  PENDING
  ROUTED
  OUT_FOR_DELIVERY
  DELIVERED
  FAILED
}

/// موظف — قد يرتبط بحساب مستخدم للنظام
model Employee {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branchId       String?
  branch         Branch?      @relation(fields: [branchId], references: [id], onDelete: SetNull)
  userId         String?      @unique
  user           User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  name           String
  nameEn         String?
  phone          String?
  email          String?
  nationalId     String?
  jobTitle       String?
  hireDate       DateTime?
  status         EmployeeStatus @default(ACTIVE)
  /// راتب أساسي افتراضي لنسخ كشوف الرواتب
  defaultBaseSalary Decimal?
  notes          String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  payrollLines   PayrollLine[]
  loans          EmployeeLoan[]
  appointments   Appointment[] @relation("AppointmentGroomer")
  commissionRules CommissionRule[]
  commissions     CommissionEntry[]

  @@index([organizationId, status])
}

/// فترة راتب شهرية
model PayrollPeriod {
  id                 String              @id @default(cuid())
  organizationId     String
  organization       Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  year               Int
  month              Int
  status             PayrollPeriodStatus @default(DRAFT)
  approvedAt         DateTime?
  approvedByUserId   String?
  approvedBy         User?               @relation("PayrollApprovedBy", fields: [approvedByUserId], references: [id], onDelete: SetNull)
  paidAt             DateTime?
  notes              String?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  lines              PayrollLine[]

  @@unique([organizationId, year, month])
}

/// سطر راتب لموظف ضمن فترة
model PayrollLine {
  id                String        @id @default(cuid())
  payrollPeriodId   String
  payrollPeriod     PayrollPeriod @relation(fields: [payrollPeriodId], references: [id], onDelete: Cascade)
  employeeId        String
  employee          Employee      @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  baseAmount        Decimal
  allowancesTotal   Decimal       @default(0)
  deductionsTotal   Decimal       @default(0)
  loanDeduction     Decimal       @default(0)
  netAmount         Decimal
  notes             String?
  loanRepayments    LoanRepayment[]

  @@unique([payrollPeriodId, employeeId])
}

/// سلفة / دين للموظف تجاه المحل
model EmployeeLoan {
  id             String             @id @default(cuid())
  organizationId String
  organization   Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  employeeId     String
  employee       Employee           @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  principal      Decimal
  paidAmount     Decimal            @default(0)
  status         EmployeeLoanStatus @default(OPEN)
  description    String?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  repayments     LoanRepayment[]

  @@index([organizationId, employeeId])
}

/// سداد من خصم راتب (يُنشأ عند تعليم الفترة «مدفوعة»)
model LoanRepayment {
  id               String       @id @default(cuid())
  employeeLoanId   String
  employeeLoan     EmployeeLoan @relation(fields: [employeeLoanId], references: [id], onDelete: Cascade)
  amount           Decimal
  payrollLineId    String?
  payrollLine      PayrollLine? @relation(fields: [payrollLineId], references: [id], onDelete: SetNull)
  note             String?
  createdAt        DateTime     @default(now())

  @@index([payrollLineId])
}

enum Role {
  ADMIN
  MANAGER
  CASHIER
  /// Floor sales associate — scan & checkout only (mobile)
  ASSOCIATE
}

enum PetType {
  CAT
  DOG
  OTHER
}

enum LocationKind {
  WAREHOUSE
  SHOP
  VAN
}

enum OrderChannel {
  IN_STORE
  VAN
  WEBSITE
}

enum SellBy {
  PIECE
  WEIGHT
}

enum PurchaseOrderStatus {
  DRAFT
  SENT
  PARTIALLY_RECEIVED
  RECEIVED
  CANCELLED
}

enum SupplierBillStatus {
  OPEN
  PARTIAL
  PAID
}

enum SupplierPayMethod {
  CASH
  BANK
}

enum WebOrderStatus {
  PENDING_PAYMENT
  CONFIRMED
  PREPARING
  OUT_FOR_DELIVERY
  READY_FOR_PICKUP
  DELIVERED
  COLLECTED
  CANCELLED
}

enum FulfillmentKind {
  DELIVERY
  PICKUP
}

enum StockMoveReason {
  RECEIPT
  TRANSFER
  SALE
  RETURN
  ADJUSTMENT
  HOLD_COMMIT
  CANCEL
}

enum HoldStatus {
  HELD
  COMMITTED
  RELEASED
}

enum PaymentMethod {
  CASH
  CARD
  ONLINE
  /// Van till: customer pays by Fawran. Staff confirm the reference. The bank is not checked automatically.
  FAWRAN
  /// Van till: customer pays from a link or QR. Staff confirm the reference.
  PAYMENT_LINK
  SPLIT
  /// الدفع عند الاستلام — نقاط الولاء تُمنح بعد تأكيد الاستلام إذا كان الإعداد ON_DELIVERY
  ON_DELIVERY
  /// بيع كامل على حساب الزبون (ذمّة)
  ON_ACCOUNT
}

enum LoyaltyEarnBase {
  /// نقاط من مبلغ كل فاتورة (بعد الخصومات اليدوية والكوبون، قبل استبدال النقاط)
  PER_ORDER_TOTAL
  /// نقاط من «سلم» مجموع مشتريات العميل (كلما زاد المجموع زادت النقاط المستحقة من الفاتورة الحالية)
  LIFETIME_SPEND
}

enum LoyaltyAwardTiming {
  /// منح النقاط عند إتمام الدفع (فوراً مع الفاتورة)
  ON_PAYMENT
  /// منح النقاط بعد تأكيد استلام الطلب (للدفع عند الاستلام أو عند تفعيل هذا الخيار)
  ON_DELIVERY
}

enum LoyaltyAwardStatus {
  NONE
  PENDING
  AWARDED
}

enum LoyaltyLedgerType {
  EARN
  REDEEM
  ADJUST
  REVERSE
}

enum CouponKind {
  PERCENT
  FIXED
}

enum CouponChannel {
  RETAIL
  WHOLESALE
  BOTH
}

enum PromotionKind {
  PERCENT
  FIXED
  PRODUCT
  CATEGORY
  BUNDLE
  BOGO
}

enum PromoChannel {
  ALL
  TILL
  WEBSITE
  GROOMING
}

enum SaleChannel {
  RETAIL
  WHOLESALE
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  PAID
  PARTIAL
  CANCELLED
}

enum CustomerLedgerEntryType {
  /// زيادة ذمّة الزبون (بيع آجل)
  SALE_CREDIT
  /// تسديد (يقلّل الذمّة)
  PAYMENT
  /// تعديل يدوي (إداري)
  ADJUSTMENT
}

model Customer {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  phone          String?
  email          String?
  notes          String?
  /// عنوان التوصيل الافتراضي (اختياري)
  address        String?
  /// رصيد نقاط الولاء الحالي
  loyaltyPoints   Int          @default(0)
  /// مجموع المشتريات المؤهّلة (لنمط LIFETIME_SPEND)
  lifetimeSpend   Decimal      @default(0)
  /// رصيد ذمّة (ما للمحل على الزبون) — يُحدَّث مع CustomerAccountLedger
  accountBalance  Decimal      @default(0)
  passwordHash    String?
  emailVerifiedAt DateTime?
  /// Approved to buy now and pay later.
  creditApproved  Boolean      @default(false)
  creditLimit     Decimal?
  locale          String       @default("ar")
  /// Staff-only labels. Never returned on the shop account.
  tags            String?
  verifyTokenHash String?
  resetTokenHash  String?      @unique
  resetExpiresAt  DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  sales          Sale[]
  loyaltyLedgers LoyaltyLedger[]
  accountLedgers CustomerAccountLedger[]
  appointments   Appointment[]
  automationLogs AutomationLog[]
  deliveryOrders DeliveryOrder[]
  deliveryStops  DeliveryStop[]
  pets           CustomerPet[]
  addresses      CustomerAddress[]
  relocationRequests RelocationRequest[]
}

/// حركات ذمم الزبائن
model CustomerAccountLedger {
  id               String                  @id @default(cuid())
  organizationId   String
  organization     Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customerId       String
  customer         Customer                @relation(fields: [customerId], references: [id], onDelete: Cascade)
  branchId         String?
  branch           Branch?                 @relation(fields: [branchId], references: [id], onDelete: SetNull)
  entryType        CustomerLedgerEntryType
  /// موجب = يزيد ما يستحقه المحل على الزبون؛ سالب = تسديد
  amount           Decimal
  saleId           String?
  sale             Sale?                   @relation(fields: [saleId], references: [id], onDelete: SetNull)
  paymentMethod    PaymentMethod?
  note             String?
  createdByUserId  String
  createdBy        User                    @relation("CustomerLedgerCreatedBy", fields: [createdByUserId], references: [id])
  createdAt        DateTime                @default(now())

  @@index([organizationId, customerId])
  @@index([saleId])
}

/// إعدادات برنامج الولاء والاستبدال لكل مؤسسة
model LoyaltyProgramSettings {
  id             String       @id @default(cuid())
  organizationId String       @unique
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  enabled        Boolean      @default(true)
  earnBase       LoyaltyEarnBase @default(PER_ORDER_TOTAL)
  /// كل قدر من العملة يمنح earnPoints (مثلاً 10 = نقطة واحدة لكل 10 من العملة)
  earnEveryAmount   Decimal   @default(10)
  earnPoints        Int       @default(1)
  minOrderForEarn   Decimal   @default(0)
  excludeWholesale  Boolean   @default(true)
  awardTiming       LoyaltyAwardTiming @default(ON_PAYMENT)
  redemptionEnabled Boolean   @default(true)
  /// كم نقطة = وحدة عملة واحدة عند الاستبدال
  redeemPointsPerCurrency Decimal @default(10)
  /// أقصى نسبة من صافي الفاتورة (بعد الخصومات وقبل الضريبة) يمكن دفعها بالنقاط
  maxRedemptionPercentOfInvoice Int @default(50)
  allowCouponWithPoints Boolean @default(true)
  /// يتطلب رقم هاتف لربط «زائر» بسجل ولاء
  guestPhoneRequired    Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Coupon {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  code           String
  kind           CouponKind   @default(PERCENT)
  /// نسبة أو مبلغ ثابت حسب kind
  value          Decimal
  minOrderAmount Decimal?
  maxDiscountAmount Decimal?
  maxUsesTotal   Int?
  maxUsesPerCustomer Int?
  usesCount      Int          @default(0)
  validFrom      DateTime     @default(now())
  validUntil     DateTime?
  active         Boolean      @default(true)
  channel        CouponChannel @default(BOTH)
  note           String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  sales          Sale[]
  promoDrafts    PromoDraft[]

  @@unique([organizationId, code])
  @@index([organizationId, active])
}

model LoyaltyLedger {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customerId     String
  customer       Customer     @relation(fields: [customerId], references: [id], onDelete: Cascade)
  saleId         String?
  sale           Sale?        @relation(fields: [saleId], references: [id], onDelete: SetNull)
  type           LoyaltyLedgerType
  points         Int
  balanceAfter   Int
  note           String?
  createdAt      DateTime     @default(now())

  @@index([organizationId, customerId])
  @@index([saleId])
}

model Brand {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  supabaseId     String?
  name           String
  nameEn         String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  products       Product[]

  @@unique([organizationId, supabaseId])
}

model Category {
  id             String        @id @default(cuid())
  organizationId String
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  supabaseId     String?
  name           String
  nameEn         String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  products       Product[]     @relation("ProductCategory")
  subcategories  Subcategory[]
  promotions     Promotion[]

  @@unique([organizationId, supabaseId])
  @@index([organizationId])
}

model Subcategory {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  categoryId     String
  category       Category     @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  name           String
  nameEn         String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  products       Product[]    @relation("ProductSubcategory")
  catalogSkus    CatalogSku[]

  @@index([organizationId])
  @@index([categoryId])
  @@unique([categoryId, name])
}

/// قائمة رموز SKU القابلة للاختيار عند إنشاء/تعديل المنتج
model CatalogSku {
  id             String        @id @default(cuid())
  organizationId String
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  code           String
  name           String?
  subcategoryId  String?
