# نسخ إلى .env أو .env.local — قيم Supabase من: Project Settings → Database

# محلياً: غالباً Direct أو Session (منفذ 5432) يعمل.
# على Vercel: استخدم Transaction pooler (منفذ 6543، مضيف aws-0-*.pooler.supabase.com) من لوحة Supabase
# مع ?pgbouncer=true&connection_limit=1&sslmode=require — الاتصال المباشر db.*.supabase.co:5432 غالباً يفشل (IPv6).
# اسم المستخدم في الـ pooler غالباً postgres.PROJECT_REF وليس postgres فقط (يظهر في نص الاتصال من Supabase).
# يمكن إضافة &pool_timeout=30 أو تقليل connection_limit عند خطأ P2024 (تجمع اتصالات مزدحم).
#
# مثال Supabase — Transaction pooler (مناسب لـ Vercel Serverless):
# postgresql://postgres.PROJECT_REF:[PASSWORD]@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1&sslmode=require
# انسخ السلسلة من Supabase → Project Settings → Database → Connection string → Transaction pooler (ليس Session ولا Direct إن كان Direct يفشل من Vercel).
# Local dev: Session or Direct (port 5432) from Supabase → Database → Connect
# Local / long-running Node: Session pooler is OK if you keep concurrency low.
# Prefer Transaction pooler on serverless (6543) to avoid EMAXCONNSESSION (pool_size ~15).
# DATABASE_URL="postgresql://postgres.PROJECT_REF:[PASSWORD]@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1&sslmode=require"
DATABASE_URL="postgresql://postgres.PROJECT_REF:[PASSWORD]@aws-0-REGION.pooler.supabase.com:5432/postgres?sslmode=require&connection_limit=5"

# Migrations: Direct connection (port 5432, host db.PROJECT_REF.supabase.co)
DIRECT_URL="postgresql://postgres:[PASSWORD]@db.PROJECT_REF.supabase.co:5432/postgres?sslmode=require"

# Vercel production: use Transaction pooler (6543) for DATABASE_URL; keep DIRECT_URL for migrate deploy
# DATABASE_URL="postgresql://postgres.PROJECT_REF:[PASSWORD]@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1&sslmode=require"

SUPABASE_URL="https://PROJECT_REF.supabase.co"
SUPABASE_ANON_KEY="your-anon-key"

JWT_SECRET="غيّر-هذا-إلى-سلسلة-عشوائية-طويلة"

# سر لإنشاء شركة جديدة عبر POST /api/auth/register-organization (8+ أحرف). لا ترفعه للعميل.
# ORG_REGISTRATION_SECRET="ضع-سلسلة-عشوائية-طويلة"

# تسجيل ذاتي من صفحة /register بدون رمز — ⚠️ فقط للبيئة التي تثق بها (اختبار أو نشر مقيد).
# ALLOW_PUBLIC_ORG_REGISTRATION=true

# لوحة إدارة المنصة: بريد/عدة بريدات ADMIN (مفصولة بفواصل). مثال حساب مخصص في البذر: platform@petstore.local
# PLATFORM_ADMIN_EMAILS="platform@petstore.local"

# اختياري — صور المنتجات إن كانت مسارات نسبية
# PUBLIC_IMAGE_BASE_URL="https://xxx.supabase.co/storage/v1/object/public/..."

# Product images are stored in the database (ProductImage) — max 2 MB per file.
# Cloudflare R2 is optional / unused for product photos in the current setup.

# Stripe (onboarding payment — Checkout + 90-day trial). Charges are always SAR.
# STRIPE_SECRET_KEY="sk_test_..."
# STRIPE_WEBHOOK_SECRET="whsec_..."
# APP_PUBLIC_URL="http://localhost:5173"
# STRIPE_CURRENCY is ignored (forced to sar)
#
# Closed testing / pilot: skip Stripe Checkout and mark payment done.
# Works even when STRIPE_SECRET_KEY is set (Stripe code stays intact).
# Production (Vercel → Environment Variables):
#   STRIPE_BYPASS_CHECKOUT=true     ← skip payment for testers
# When ready for real billing: remove it or set =false, then redeploy.
# STRIPE_BYPASS_CHECKOUT=true

# Onboarding approve/reject notices (optional — feedback MVP works without these):
# ONBOARDING_NOTIFY_WEBHOOK_URL="https://hooks.zapier.com/..."  # → WhatsApp/SMS via Make/Zapier
# RESEND_API_KEY="re_..."
# ONBOARDING_NOTIFY_FROM_EMAIL="ICODO <onboarding@yourdomain.com>"
# ONBOARDING_NOTIFY_EMAIL="ops@yourdomain.com"  # BCC/ops copy
